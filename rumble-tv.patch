+    @Override public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus && focusPlaybackOnWindowFocus && view != null) {
+            if (view.getPlayer() != null) focusPlaybackControls();
+            else view.requestFocus();
+            focusPlaybackOnWindowFocus = false;
+        }
+    }
+
+    @Override public boolean dispatchKeyEvent(KeyEvent event) {
+        if (view == null) return super.dispatchKeyEvent(event);
+        int key = event.getKeyCode();
+        // Media keys belong to playback even while a header control owns focus.
+        if (view.dispatchMediaKeyEvent(event)) {
+            view.showController();
+            return true;
+        }
+        if (key == KeyEvent.KEYCODE_BACK && (dismissingControls || view.isControllerVisible())) {
+            if (event.getAction() == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0) {
+                dismissingControls = true;
+                view.hideController();
+                view.requestFocus();
+            } else if (event.getAction() == KeyEvent.ACTION_UP) {
+                dismissingControls = false;
+            }
+            return true;
+        }
+        boolean direction = key == KeyEvent.KEYCODE_DPAD_UP || key == KeyEvent.KEYCODE_DPAD_DOWN;
+        if (direction) {
+            if (event.getAction() == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0) {
+                if (follow.hasFocus()) {
+                    if (key == KeyEvent.KEYCODE_DPAD_DOWN) focusPlaybackControls();
+                } else if (!view.isControllerVisible() || view.isFocused()) {
+                    focusPlaybackControls();
+                } else if (key == KeyEvent.KEYCODE_DPAD_UP) {
+                    if (view.findViewById(com.google.android.exoplayer2.ui.R.id.exo_progress).hasFocus()) {
+                        focusPlaybackControls();
+                    } else if (follow.getVisibility() == View.VISIBLE) {
+                        view.hideController();
+                        follow.requestFocus();
+                    }
+                } else {
+                    view.findViewById(com.google.android.exoplayer2.ui.R.id.exo_progress).requestFocus();
+                }
+            }
+            return true;
+        }
+        boolean center = key == KeyEvent.KEYCODE_DPAD_CENTER || key == KeyEvent.KEYCODE_ENTER;
+        boolean horizontal = key == KeyEvent.KEYCODE_DPAD_LEFT || key == KeyEvent.KEYCODE_DPAD_RIGHT;
+        if ((center || horizontal) && !follow.hasFocus() &&
+                (shortcutKey == key || !view.isControllerVisible() || view.isFocused())) {
+            // Keep both halves (and repeats) of a hidden-controller shortcut on
+            // the same path after DOWN shows/focuses the playback controls.
+            if (event.getAction() == KeyEvent.ACTION_DOWN) shortcutKey = key;
+            int mediaKey = center ? KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE :
+                    key == KeyEvent.KEYCODE_DPAD_LEFT ? KeyEvent.KEYCODE_MEDIA_REWIND : KeyEvent.KEYCODE_MEDIA_FAST_FORWARD;
+            KeyEvent media = new KeyEvent(event.getDownTime(), event.getEventTime(), event.getAction(),
+                    mediaKey, event.getRepeatCount(), event.getMetaState(), event.getDeviceId(),
+                    event.getScanCode(), event.getFlags(), event.getSource());
+            view.dispatchMediaKeyEvent(media);
+            focusPlaybackControls();
+            if (event.getAction() == KeyEvent.ACTION_UP) shortcutKey = KeyEvent.KEYCODE_UNKNOWN;
+            return true;
+        }
+        // Visible buttons and the time bar retain ExoPlayer's normal click/scrub behavior.
+        return super.dispatchKeyEvent(event);
+    }
+
+    private void focusPlaybackControls() {
+        view.showController();
+        Player current = view.getPlayer();
+        boolean pause = current != null && current.getPlayWhenReady() &&
+                current.getPlaybackState() != Player.STATE_IDLE && current.getPlaybackState() != Player.STATE_ENDED;
+        View button = view.findViewById(pause ? com.google.android.exoplayer2.ui.R.id.exo_pause :
+                com.google.android.exoplayer2.ui.R.id.exo_play);
+        if (button == null || !button.requestFocus()) view.requestFocus();
     }
 
