# Copy to vps-sync/.env on the VPS. Never commit the actual .env file.
# Generate with: openssl rand -hex 32
SMARTTUBE_SETUP_CODE=replace-with-your-own-long-random-code

# Optional: server-side API.SH key for Rumble search, feeds and stream lookup.
# Rumble discovery does not work without this provider key.
APISH_KEY=
