+    /** TV watch-next must survive ordinary title variation, while still requiring subject evidence. */
+    public static List<Video> rankForPlayback(Video current, List<Video> candidates) {
+        List<Video> result = new ArrayList<>();
+        if (current == null || candidates == null) return result;
+        Set<String> seen = new HashSet<>();
+        for (Video item : candidates) {
+            if (item == null || item.videoId == null || item.videoId.equals(current.videoId) ||
+                    item.isChapter || item.isUpcoming || item.isUnplayable || !seen.add(item.videoId)) continue;
+            if (playbackScore(current, item) > 0) result.add(item);
+        }
+        java.util.Collections.sort(result, (left, right) -> {
+            int subject = Integer.compare(playbackScore(current, right), playbackScore(current, left));
+            return subject != 0 ? subject : Boolean.compare(sameChannel(current, right), sameChannel(current, left));
+        });
+        return result;
+    }
+
+    public static int playbackScore(Video current, Video candidate) {
+        int strict = score(current, candidate);
+        if (strict > 0) return 1000 + strict;
+        Set<String> subject = terms(current != null ? current.getTitle() : null);
+        Set<String> other = terms(candidate != null ? candidate.getTitle() : null);
+        int overlap = 0;
+        for (String term : subject) if (other.contains(term) && term.length() >= 3) overlap++;
+        // Requiring a word from the final third erased relevant titles with different word order.
+        // Partial matches remain below strong matches; publisher alone never qualifies.
+        boolean specificTerm = false;
+        for (String term : subject) if (term.length() >= 4 && other.contains(term)) specificTerm = true;
+        if (overlap < 2 && !(subject.size() <= 3 && overlap == 1 && specificTerm)) return 0;
+        if (subject.size() >= 4) {
+            List<String> ordered = new ArrayList<>(subject);
+            boolean topic = false;
+            for (int index = ordered.size() / 2; index < ordered.size(); index++)
+                if (other.contains(ordered.get(index))) topic = true;
+            if (!topic) return 0;
+        }
+        return (int) (500.0 * overlap / Math.max(1, subject.size()) +
+                200.0 * overlap / Math.max(1, other.size()));
     }
 
