+        youtube.clear();
+        rumble.clear();
+        visible.clear();
+        adapter.notifyDataSetChanged();
+        updateButtons();
+        refreshSidebar();
+        String filter = sync.sourceFilter();
+        boolean showYoutube = !"rumble".equals(filter) && selectedChannel.isEmpty();
+        boolean showRumble = !"youtube".equals(filter) || !selectedChannel.isEmpty();
+        pending = 0;
+        if (showYoutube) loadYoutube(serial);
+        if (showRumble) loadRumble(serial);
+        info.setText(pending > 0 ? "Loading " + filter + " videos…" : "No videos yet");
+    }
+
+    private void loadYoutube(int serial) {
+        pending++;
+        if (!query.isEmpty()) {
+            actions.add(YouTubeServiceManager.instance().getContentService()
+                    .getSearchObserve(query, SearchOptions.TYPE_VIDEO)
+                    .subscribe(groups -> runOnUiThread(() -> { addYoutube(groups, serial); done(serial); }),
+                            error -> runOnUiThread(() -> done(serial))));
+        } else if (subscriptions) {
+            actions.add(YouTubeServiceManager.instance().getContentService()
+                    .getSubscriptionsObserve()
+                    .subscribe(group -> runOnUiThread(() -> {
+                        addYoutube(Collections.singletonList(group), serial);
+                        done(serial);
+                    }), error -> runOnUiThread(() -> done(serial))));
+        } else {
+            actions.add(Observable.fromCallable(() -> YouTubeServiceManager.instance().getContentService().getHome())
+                    .subscribeOn(io.reactivex.schedulers.Schedulers.io())
+                    .subscribe(groups -> runOnUiThread(() -> { addYoutube(groups, serial); done(serial); }),
+                            error -> runOnUiThread(() -> done(serial))));
+        }
+    }
+
+    private void addYoutube(List<MediaGroup> groups, int serial) {
+        if (serial != generation || groups == null) return;
+        HashSet<String> ids = new HashSet<>();
+        for (Item current : youtube) if (current.youtube != null) ids.add(current.youtube.videoId);
+        for (MediaGroup group : groups) {
+            if (group == null || group.getType() == MediaGroup.TYPE_SHORTS) continue;
+            VideoGroup videos = VideoGroup.from(group);
+            if (videos == null || videos.getVideos() == null) continue;
+            for (Video video : videos.getVideos()) {
+                if (video != null && video.videoId != null && !video.isShorts && ids.add(video.videoId))
+                    youtube.add(new Item(video));
+            }
+        }
+        rebuild(serial);
+    }
+
+    private void loadRumble(int serial) {
+        if (!sync.paired()) return;
+        if (!selectedChannel.isEmpty()) {
+            pending++;
+            sync.rumbleChannel(selectedChannel, response -> appendRumble(response, serial));
+        } else if (!query.isEmpty()) {
+            pending++;
+            sync.rumbleSearch(query, response -> appendRumble(response, serial));
+        } else if (!subscriptions) {
+            pending++;
+            sync.rumbleHome(response -> appendRumble(response, serial));
+        } else {
+            JSONArray channels = sync.followedChannels();
+            int count = Math.min(10, channels.length());
+            for (int i = 0; i < count; i++) {
+                JSONObject channel = channels.optJSONObject(i);
+                if (channel == null) continue;
+                pending++;
+                sync.rumbleChannel(channelUrl(channel.optString("id")), response -> appendRumble(response, serial));
+            }
+        }
+    }
+
+    private void appendRumble(PatSyncClient.Result response, int serial) {
+        if (serial != generation) return;
+        if (response.ok()) {
+            JSONArray videos = response.data.optJSONArray("videos");
+            HashSet<String> ids = new HashSet<>();
+            for (Item current : rumble) ids.add(current.rumble.optString("id"));
+            if (videos != null) for (int i = 0; i < videos.length(); i++) {
+                JSONObject value = videos.optJSONObject(i);
+                if (value != null && ids.add(value.optString("id"))) rumble.add(new Item(value));
+            }
+        } else if ("rumble".equals(sync.sourceFilter()) || !selectedChannel.isEmpty()) {
+            toast(response.message);
+        }
+        rebuild(serial);
+        done(serial);
+    }
+
+    private void rebuild(int serial) {
+        if (serial != generation) return;
+        visible.clear();
+        if ("youtube".equals(sync.sourceFilter())) visible.addAll(youtube);
+        else if ("rumble".equals(sync.sourceFilter()) || !selectedChannel.isEmpty()) visible.addAll(rumble);
+        else {
+            // Same shape for both providers, with neither feed buried underneath the other.
+            int y = 0, r = 0;
+            while (y < youtube.size() || r < rumble.size()) {
+                for (int n = 0; n < 2 && y < youtube.size(); n++) visible.add(youtube.get(y++));
+                if (r < rumble.size()) visible.add(rumble.get(r++));
+            }
+        }
+        adapter.notifyDataSetChanged();
+        if (!visible.isEmpty()) info.setText(visible.size() + " videos • " + sync.sourceFilter());
+    }
+
+    private void done(int serial) {
+        if (serial != generation) return;
+        pending = Math.max(0, pending - 1);
+        if (pending == 0 && visible.isEmpty()) {
+            info.setText(sync.sourceFilter().equals("rumble") && sync.followedChannels().length() == 0 && query.isEmpty()
+                    ? "Follow a Rumble channel or use Search to see videos."
+                    : "No videos available. Check the connection or try Search.");
+        }
+    }
+
+    private void open(Item item) {
+        if (!item.isRumble()) PlaybackPresenter.instance(this).openVideo(item.youtube);
+        else startActivity(new Intent(this, PatRumblePlayerActivity.class)
+                .putExtra(PatRumblePlayerActivity.EXTRA_VIDEO, item.rumble.toString()));
+    }
+
+    private void toast(String value) { Toast.makeText(this, value, Toast.LENGTH_LONG).show(); }
+
+    private void showSyncDialog() {
+        if (!sync.paired()) {
+            if (tv) startTvPairing();
+            else startPhoneAuthorization();
+            return;
+        }
+        String[] choices = tv
+                ? new String[]{"Sync now", "Disconnect this TV"}
+                : new String[]{"Sync now", "Link Google TV", "Change Bunny server", "Disconnect this phone"};
+        new AlertDialog.Builder(this).setTitle("Bunny sync")
+                .setItems(choices, (dialog, index) -> {
+                    if (index == 0) sync.syncNow(result -> {
+                        toast(result.message);
+                        if (result.ok()) loadFeed();
+                    });
+                    else if (!tv && index == 1) approveTvPairing();
+                    else if (!tv && index == 2) promptServerUrl(() -> startPhoneAuthorization());
+                    else {
+                        sync.clearPairing();
+                        toast("Device disconnected");
+                    }
+                }).show();
+    }
+
+    private void promptServerUrl(Runnable onSaved) {
+        EditText server = new EditText(this);
+        server.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        server.setText(sync.endpoint());
+        server.setHint("https://your-edge-script.bunny...");
+        new AlertDialog.Builder(this).setTitle("Bunny Edge Script URL")
+                .setMessage("This is the public HTTPS endpoint, not the private database URL or token.")
+                .setView(server).setNegativeButton("Cancel", null)
+                .setPositiveButton("Continue", (dialog, which) -> {
+                    try { sync.configureEndpoint(server.getText().toString()); onSaved.run(); }
+                    catch (Exception error) { toast(error.getMessage()); }
+                }).show();
+    }
+
+    private void startPhoneAuthorization() {
+        // Phone can load an already-published endpoint from sync_config.json.
+        if (sync.endpoint().isEmpty()) {
+            promptServerUrl(this::askSetupCode);
+        } else askSetupCode();
+    }
+
+    private void askSetupCode() {
+        EditText code = new EditText(this);
+        code.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        code.setSingleLine(true);
+        new AlertDialog.Builder(this).setTitle("Authorize this phone")
+                .setMessage("Enter your Bunny sync setup code once. It is never stored or sent to the TV.")
+                .setView(code).setNegativeButton("Cancel", null)
+                .setPositiveButton("Connect", (dialog, which) -> sync.authorizePhone(code.getText().toString(), result -> {
+                    code.setText("");
+                    toast(result.message);
+                    if (result.ok()) loadFeed();
+                })).show();
+    }
+
+    private void approveTvPairing() {
+        EditText code = new EditText(this);
+        code.setInputType(InputType.TYPE_CLASS_NUMBER);
+        code.setSingleLine(true);
+        code.setHint("10-digit code on TV");
+        new AlertDialog.Builder(this).setTitle("Link TV to your Bunny account")
+                .setView(code).setNegativeButton("Cancel", null)
+                .setPositiveButton("Approve", (dialog, which) ->
+                        sync.approvePairing(code.getText().toString(), result -> toast(result.message)))
+                .show();
+    }
+
+    private void startTvPairing() {
+        sync.startPairing(result -> {
+            if (!result.ok()) { toast(result.message); return; }
+            String code = result.data.optString("code");
+            final boolean[] open = {true};
+            AlertDialog popup = new AlertDialog.Builder(this).setTitle("Link this Google TV")
+                    .setMessage("On the PHONE: PatTube → Sync → Link Google TV\n\nEnter code: " + code +
+                            "\n\nWaiting for your phone… (expires in 5 minutes)")
+                    .setNegativeButton("Cancel", (dialog, which) -> open[0] = false)
+                    .create();
+            popup.setOnDismissListener(dialog -> open[0] = false);
+            popup.show();
+            Runnable poll = new Runnable() {
+                @Override public void run() {
+                    if (!open[0] || isFinishing()) return;
+                    sync.pairingStatus(status -> {
+                        if (!open[0]) return;
+                        if (status.ok() && sync.paired()) {
+                            open[0] = false;
+                            popup.dismiss();
+                            toast("TV connected and synchronized");
+                            loadFeed();
+                        } else if (status.code == 410) {
+                            open[0] = false;
+                            popup.dismiss();
+                            toast("Code expired. Start pairing again.");
+                        } else ui.postDelayed(this, 3_000);
+                    });
+                }
+            };
+            ui.post(poll);
+        });
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        if (sync != null && cards != null && sync.paired())
+            sync.syncNow(result -> { if (result.ok()) { updateButtons(); refreshSidebar(); } });
+    }
+
+    @Override protected void onDestroy() {
+        generation++;
+        actions.clear();
+        ui.removeCallbacksAndMessages(null);
+        super.onDestroy();
+    }
+
+    private final class CardAdapter extends RecyclerView.Adapter<CardAdapter.Holder> {
+        final class Holder extends RecyclerView.ViewHolder {
+            final ImageView image;
+            final TextView title;
+            final TextView channel;
+            Holder(View view, ImageView image, TextView title, TextView channel) {
+                super(view);
+                this.image = image; this.title = title; this.channel = channel;
+            }
+        }
+        @NonNull @Override public Holder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            LinearLayout card = new LinearLayout(parent.getContext());
+            card.setOrientation(LinearLayout.VERTICAL);
+            card.setPadding(dp(6), dp(6), dp(6), dp(16));
+            card.setFocusable(true);
+            card.setClickable(true);
+            card.setBackgroundColor(PANEL);
+            ImageView image = new TopCropView(parent.getContext());
+            card.addView(image, new LinearLayout.LayoutParams(-1, dp(tv ? 148 : 110)));
+            TextView title = new TextView(parent.getContext());
+            title.setTextColor(WHITE); title.setTextSize(tv ? 17 : 15); title.setMaxLines(2);
+            title.setPadding(dp(5), dp(6), dp(5), dp(1));
+            card.addView(title, new LinearLayout.LayoutParams(-1, -2));
+            TextView channel = new TextView(parent.getContext());
+            channel.setTextColor(Color.LTGRAY); channel.setTextSize(tv ? 14 : 12); channel.setMaxLines(1);
+            channel.setPadding(dp(5), dp(2), dp(5), dp(2));
+            card.addView(channel, new LinearLayout.LayoutParams(-1, -2));
+            return new Holder(card, image, title, channel);
+        }
+        @Override public void onBindViewHolder(@NonNull Holder holder, int index) {
+            Item item = visible.get(index);
+            holder.title.setText(item.title());
+            holder.channel.setText((item.isRumble() ? "Rumble • " : "YouTube • ") + item.channel());
+            Glide.with(holder.image).load(item.thumbnail()).into(holder.image);
+            holder.itemView.setOnClickListener(view -> open(item));
+            holder.itemView.setOnFocusChangeListener((view, focused) -> view.setBackgroundColor(focused ? RED : PANEL));
+            holder.itemView.setOnLongClickListener(view -> {
+                if (item.isRumble()) {
+                    String id = item.rumble.optString("channelUrl", item.rumble.optString("channelId"));
+                    sync.follow(id, item.rumble.optString("channelName", id), !sync.isFollowed(id));
+                    if (sync.paired()) sync.syncNow(null);
+                    refreshSidebar();
+                    toast(sync.isFollowed(id) ? "Following channel" : "Unfollowed channel");
+                    return true;
+                }
+                return false;
+            });
+        }
+        @Override public int getItemCount() { return visible.size(); }
+    }
+}
