@@ -0,0 +1,129 @@
+package com.liskovsoft.smartyoutubetv2.mobile.sync;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.widget.Toast;
+
+import com.liskovsoft.smartyoutubetv2.tv.R;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+public final class PatRumbleFollow {
+    private static final int MAX_MATCHES = 8;
+    private static final Pattern CHANNEL_URL =
+            Pattern.compile("https://rumble\\.com/(c|user)/[A-Za-z0-9_-]{2,100}/?");
+
+    private PatRumbleFollow() { }
+
+    public static void show(Activity activity, String author) {
+        String creator = author == null ? "" : author.trim();
+        if (nameKey(creator).isEmpty()) {
+            Toast.makeText(activity, R.string.pat_rumble_creator_unavailable, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        PatSyncClient sync = new PatSyncClient(activity);
+        if (!sync.paired()) {
+            new AlertDialog.Builder(activity).setTitle(R.string.pat_follow_on_rumble)
+                    .setMessage(R.string.pat_rumble_follow_pair_first)
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .setPositiveButton(R.string.pat_rumble_open_sync, (dialog, which) ->
+                            activity.startActivity(new Intent(activity, PatHubActivity.class)))
+                    .show();
+            return;
+        }
+
+        AlertDialog loading = new AlertDialog.Builder(activity)
+                .setTitle(R.string.pat_follow_on_rumble)
+                .setMessage(activity.getString(R.string.pat_rumble_follow_searching, creator))
+                .setNegativeButton(android.R.string.cancel, null).show();
+        // The sync API accepts queries of 2–100 characters. Quote a one-character
+        // name so the provider still searches for the original creator name.
+        String query = creator.length() == 1 ? "\"" + creator + "\"" :
+                creator.substring(0, Math.min(creator.length(), 100));
+        sync.rumbleSearch(query, result -> {
+            if (activity.isFinishing() || activity.isDestroyed() || !loading.isShowing()) return;
+            loading.dismiss();
+            if (!result.ok()) {
+                Toast.makeText(activity, result.message, Toast.LENGTH_LONG).show();
+                return;
+            }
+            showMatches(activity, sync, creator, result.data.optJSONArray("videos"));
+        });
+    }
+
+    private static void showMatches(Activity activity, PatSyncClient sync, String creator, JSONArray videos) {
+        List<Channel> channels = matchingChannels(creator, videos);
+        AlertDialog.Builder dialog = new AlertDialog.Builder(activity)
+                .setTitle(activity.getString(R.string.pat_rumble_follow_choose, creator))
+                .setNegativeButton(android.R.string.cancel, null);
+        if (channels.isEmpty()) {
+            dialog.setMessage(R.string.pat_rumble_follow_no_matches).show();
+            return;
+        }
+        List<String> labels = new ArrayList<>();
+        for (Channel channel : channels) {
+            labels.add(activity.getString(R.string.pat_rumble_follow_result, channel.name,
+                    channel.url.substring("https://".length())));
+        }
+        dialog.setItems(labels.toArray(new String[0]), (selected, index) -> {
+            Channel channel = channels.get(index);
+            if (!sync.isFollowed(channel.url)) {
+                sync.follow(channel.url, channel.name, true);
+                sync.syncNow(null);
+            }
+            Toast.makeText(activity, activity.getString(R.string.pat_rumble_follow_saved, channel.name),
+                    Toast.LENGTH_SHORT).show();
+        }).show();
+    }
+
+    private static List<Channel> matchingChannels(String creator, JSONArray videos) {
+        String creatorKey = nameKey(creator);
+        Map<String, Channel> unique = new LinkedHashMap<>();
+        if (videos != null) for (int i = 0; i < videos.length(); i++) {
+            JSONObject video = videos.optJSONObject(i);
+            if (video == null) continue;
+            String url = video.optString("channelUrl");
+            String name = video.optString("channelName").trim();
+            if (name.isEmpty() || !CHANNEL_URL.matcher(url).matches()) continue;
+            if (url.endsWith("/")) url = url.substring(0, url.length() - 1);
+            String displayKey = nameKey(name);
+            String handleKey = nameKey(url.substring(url.lastIndexOf('/') + 1));
+            boolean exact = creatorKey.equals(displayKey) || creatorKey.equals(handleKey);
+            boolean similar = creatorKey.length() >= 4 &&
+                    (displayKey.contains(creatorKey) || handleKey.contains(creatorKey));
+            if (!exact && !similar) continue;
+            String key = url.toLowerCase(Locale.ROOT);
+            if (!unique.containsKey(key)) unique.put(key, new Channel(url, name, exact));
+        }
+        List<Channel> ranked = new ArrayList<>(unique.values());
+        // Keep the provider's result order within exact and similar names.
+        Collections.sort(ranked, (left, right) -> Boolean.compare(right.exact, left.exact));
+        return ranked.subList(0, Math.min(ranked.size(), MAX_MATCHES));
+    }
+
+    private static String nameKey(String name) {
+        return name.toLowerCase(Locale.ROOT).replaceAll("[^\\p{L}\\p{N}]", "");
+    }
+
+    private static final class Channel {
+        final String url;
+        final String name;
+        final boolean exact;
+
+        Channel(String url, String name, boolean exact) {
+            this.url = url;
+            this.name = name;
+            this.exact = exact;
+        }
+    }
+}
diff --git a/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/mobile/sync/PatRumblePlayerActivity.java b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/mobile/sync/PatRumblePlayerActivity.java
new file mode 100644
