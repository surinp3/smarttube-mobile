+        Tile(VideoGroupObjectAdapter category, Video video, String heading) {
+            this.category = category;
+            this.video = video;
+            this.heading = heading;
+        }
+
+        boolean isShowMore() {
+            return video == null && heading == null;
+        }
+    }
+
+    private final class TileHolder extends RecyclerView.ViewHolder {
+        final androidx.leanback.widget.Presenter.ViewHolder card;
+
+        TileHolder(View view, androidx.leanback.widget.Presenter.ViewHolder card) {
+            super(view);
+            this.card = card;
+        }
+    }
+
+    private final class HomeAdapter extends RecyclerView.Adapter<TileHolder> {
+        private List<Tile> tiles = new ArrayList<>();
+
+        void replace(List<Tile> next, VideoGroupObjectAdapter updated) {
+            List<Tile> old = tiles;
+            DiffUtil.DiffResult changes = DiffUtil.calculateDiff(new DiffUtil.Callback() {
+                @Override public int getOldListSize() { return old.size(); }
+                @Override public int getNewListSize() { return next.size(); }
+                @Override public boolean areItemsTheSame(int previous, int current) {
+                    Tile a = old.get(previous);
+                    Tile b = next.get(current);
+                    return a.category == b.category && a.video == b.video && a.isShowMore() == b.isShowMore();
+                }
+                @Override public boolean areContentsTheSame(int previous, int current) {
+                    return next.get(current).category != updated;
+                }
+            }, false);
+            tiles = next;
+            changes.dispatchUpdatesTo(this);
+        }
+
+        @Override public int getItemCount() { return tiles.size(); }
+        @Override
+        public int getItemViewType(int position) {
+            Tile tile = tiles.get(position);
+            if (tile.isShowMore()) return 2;
+            return tile.video == null ? 0 : 1;
+        }
+
+        @Override
+        public TileHolder onCreateViewHolder(ViewGroup parent, int type) {
+            if (type == 2) {
+                Button button = new Button(parent.getContext());
+                button.setText(R.string.pat_show_more_recent);
+                button.setTextSize(18);
+                button.setAllCaps(false);
+                button.setFocusable(true);
+                button.setOnClickListener(view -> {
+                    RecyclerView.ViewHolder holder = mGrid.getChildViewHolder(view);
+                    showMoreRecent((TileHolder) holder);
+                });
+                return new TileHolder(button, null);
+            }
+            if (type == 0) {
+                TextView heading = new TextView(parent.getContext());
+                heading.setTextColor(Color.WHITE);
+                heading.setTextSize(24);
+                heading.setTypeface(null, Typeface.BOLD);
+                heading.setPadding(mSpacing / 2, mSpacing, mSpacing / 2, mSpacing);
+                heading.setFocusable(false);
+                return new TileHolder(heading, null);
+            }
+            androidx.leanback.widget.Presenter.ViewHolder card = mCards.onCreateViewHolder(parent);
+            RecyclerView.LayoutParams params = new RecyclerView.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            params.setMargins(mSpacing / 2, 0, mSpacing / 2, mSpacing);
+            card.view.setLayoutParams(params);
+            return new TileHolder(card.view, card);
+        }
+
+        @Override
+        public void onBindViewHolder(TileHolder holder, int position) {
+            Tile tile = tiles.get(position);
+            if (holder.card == null) {
+                if (!tile.isShowMore()) ((TextView) holder.itemView).setText(tile.heading);
+                return;
+            }
+            mCards.onBindViewHolder(holder.card, tile.video);
+            holder.itemView.setSelected(holder.itemView.hasFocus());
+            holder.itemView.setOnFocusChangeListener((v, focused) -> {
+                v.setSelected(focused);
+                if (focused) onFocused(tile);
+            });
+            holder.itemView.setOnClickListener(v -> {
+                if (PatRumbleCards.isRumble(tile.video)) PatRumbleCards.open(requireContext(), tile.video);
+                else mBrowse.onVideoItemClicked(tile.video);
+            });
+        }
+
+        @Override
+        public void onViewRecycled(TileHolder holder) {
+            if (holder.card == null) return;
+            holder.itemView.setOnFocusChangeListener(null);
+            holder.itemView.setOnClickListener(null);
+            mCards.onUnbindViewHolder(holder.card);
+        }
+    }
+}
