+        if (followRumble != null) {
+            adapter.add(followRumble);
+        }
         if (mPlayerTweaksData.isPlayerButtonEnabled(PlayerTweaksData.PLAYER_BUTTON_VIDEO_INFO)) {
             adapter.add(mActions.get(R.id.action_info));
         }
