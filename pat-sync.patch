index 000000000..01100701f
--- /dev/null
+++ b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/mobile/sync/PatSyncClient.java
@@ -0,0 +1,511 @@
+package com.liskovsoft.smartyoutubetv2.mobile.sync;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Private per-device credentials, public Bunny Edge URL discovery, and
+ * revision-safe state synchronization shared by the phone and Google TV.
+ * Database credentials and the Rumble provider API key never reach Android.
+ */
+public final class PatSyncClient {
+    private static final String CONFIG_URL =
+            "https://raw.githubusercontent.com/surinp3/smarttube-mobile/main/sync_config.json";
+    private static final String PREFS = "pat_bunny_sync";
+    private static final ExecutorService EXEC = Executors.newSingleThreadExecutor();
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final String DEFAULT_STATE =
+            "{\"sourceFilter\":\"both\",\"channels\":[],\"sidebar\":[],\"progress\":[]}";
+
+    public interface Callback { void onResult(Result result); }
+
+    public static final class Result {
+        public final int code;
+        public final JSONObject data;
+        public final String message;
+        Result(int code, JSONObject data, String message) {
+            this.code = code;
+            this.data = data == null ? new JSONObject() : data;
+            this.message = message;
+        }
+        public boolean ok() { return code >= 200 && code < 300; }
+    }
+
+    private interface Work { Result run() throws Exception; }
+
+    private final SharedPreferences prefs;
+
+    public PatSyncClient(Context context) {
+        prefs = context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public String endpoint() { return prefs.getString("endpoint", ""); }
+    public boolean paired() { return !TextUtils.isEmpty(prefs.getString("token", "")); }
+    public String sourceFilter() { return state().optString("sourceFilter", "both"); }
+    public JSONObject state() {
+        try { return new JSONObject(prefs.getString("state", DEFAULT_STATE)); }
+        catch (Exception ignored) {
+            try { return new JSONObject(DEFAULT_STATE); }
+            catch (Exception impossible) { return new JSONObject(); }
+        }
+    }
+
+    private static String validatedEndpoint(String input) {
+        try {
+            URL url = new URL(input == null ? "" : input.trim());
+            if (!"https".equals(url.getProtocol()) || TextUtils.isEmpty(url.getHost()) ||
+                    url.getUserInfo() != null || url.getQuery() != null || url.getRef() != null) return null;
+            String clean = url.toExternalForm();
+            while (clean.endsWith("/")) clean = clean.substring(0, clean.length() - 1);
+            return clean.length() <= 400 ? clean : null;
+        } catch (Exception ignored) { return null; }
+    }
+
+    /** Changing servers revokes the local session to avoid sending a token elsewhere. */
+    public void configureEndpoint(String url) {
+        String valid = validatedEndpoint(url);
+        if (valid == null) throw new IllegalArgumentException("An HTTPS Bunny Edge Script URL is required");
+        if (!valid.equals(endpoint())) {
+            prefs.edit().putString("endpoint", valid).remove("token")
+                    .remove("pending").remove("revision").apply();
+        }
+    }
+
+    public void clearPairing() {
+        prefs.edit().remove("token").remove("pending").remove("revision").apply();
+    }
+
+    private String discoverEndpoint() throws Exception {
+        String local = validatedEndpoint(endpoint());
+        if (local != null) return local;
+        HttpURLConnection connection = (HttpURLConnection) new URL(CONFIG_URL).openConnection();
+        connection.setConnectTimeout(7000);
+        connection.setReadTimeout(7000);
+        try {
+            if (connection.getResponseCode() != 200) throw new IllegalStateException("Sync configuration unavailable");
+            String content = readLimited(connection.getInputStream(), 8192);
+            JSONObject json = new JSONObject(content);
+            String discovered = validatedEndpoint(json.optString("edgeScriptUrl", ""));
+            if (!json.optBoolean("enabled") || discovered == null)
+                throw new IllegalStateException("Bunny sync isn't activated yet");
+            prefs.edit().putString("endpoint", discovered).apply();
+            return discovered;
+        } finally { connection.disconnect(); }
+    }
+
+    private static String readLimited(InputStream input, int max) throws Exception {
+        try (InputStream stream = input; ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = stream.read(buffer)) != -1) {
+                if (out.size() + count > max) throw new IllegalStateException("Response too large");
+                out.write(buffer, 0, count);
+            }
+            return out.toString("UTF-8");
+        }
+    }
+
+    private Result request(String path, String method, JSONObject body, String auth) throws Exception {
+        URL target = new URL(discoverEndpoint() + path);
+        HttpURLConnection connection = (HttpURLConnection) target.openConnection();
+        connection.setConnectTimeout(9000);
+        connection.setReadTimeout(15000);
+        connection.setRequestMethod(method);
+        connection.setRequestProperty("Accept", "application/json");
+        connection.setRequestProperty("Cache-Control", "no-cache");
+        if (auth != null && !auth.isEmpty()) connection.setRequestProperty("Authorization", "Bearer " + auth);
+        if (body != null) {
+            connection.setDoOutput(true);
+            connection.setRequestProperty("Content-Type", "application/json");
+            try (OutputStream stream = connection.getOutputStream()) {
+                stream.write(body.toString().getBytes(StandardCharsets.UTF_8));
+            }
+        }
+        try {
+            int status = connection.getResponseCode();
+            InputStream stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream();
+            JSONObject data = stream == null ? new JSONObject() : new JSONObject(readLimited(stream, 350_000));
+            return new Result(status, data, data.optString("error", status < 400 ? "OK" : "Request failed"));
+        } finally { connection.disconnect(); }
+    }
+
+    private static void enqueue(Work work, Callback callback) {
+        EXEC.execute(() -> {
+            Result result;
+            try { result = work.run(); }
+            catch (Exception error) {
+                result = new Result(0, null,
+                        error.getMessage() != null ? error.getMessage() : "Connection unavailable");
+            }
+            final Result complete = result;
+            if (callback != null) MAIN.post(() -> callback.onResult(complete));
+        });
+    }
+
+    /** Called on the phone once; setup code is never retained in preferences. */
+    public void authorizePhone(String setupCode, Callback done) {
+        enqueue(() -> {
+            JSONObject body = new JSONObject().put("setupCode", setupCode)
+                    .put("deviceName", "Android phone");
+            Result result = request("/v1/device/bootstrap", "POST", body, null);
+            if (result.ok()) {
+                String token = result.data.optString("deviceToken", "");
+                if (token.matches("[0-9a-f]{64}")) {
+                    prefs.edit().putString("token", token).remove("pending").apply();
+                    return syncBlocking();
+                }
+                return new Result(502, null, "Bunny server returned an invalid device token");
+            }
+            return result;
+        }, done);
+    }
+
+    /** TV-only initial setup. The TV receives only a temporary random token. */
+    public void startPairing(Callback done) {
+        enqueue(() -> {
+            Result result = request("/v1/pair/start", "POST", new JSONObject(), null);
+            if (result.ok() && result.data.optString("pendingToken", "").matches("[0-9a-f]{64}"))
+                prefs.edit().putString("pending", result.data.optString("pendingToken")).apply();
+            return result;
+        }, done);
+    }
+
+    public void pairingStatus(Callback done) {
+        enqueue(() -> {
+            String pending = prefs.getString("pending", "");
+            if (pending.isEmpty()) return new Result(400, null, "No pairing request in progress");
+            Result result = request("/v1/pair/status", "GET", null, pending);
+            if (result.ok() && "approved".equals(result.data.optString("status"))) {
+                // A new TV adopts the phone's cloud state on its first sync.
+                prefs.edit().putString("token", pending).remove("pending").remove("dirty").apply();
+                return syncBlocking();
+            }
+            return result;
+        }, done);
+    }
+
+    public void approvePairing(String code, Callback done) {
+        enqueue(() -> request("/v1/pair/approve", "POST",
+                new JSONObject().put("code", code), prefs.getString("token", "")), done);
+    }
+
+    public void syncNow(Callback done) { enqueue(this::syncBlocking, done); }
+
+    private Result syncBlocking() throws Exception {
+        String token = prefs.getString("token", "");
+        if (token.isEmpty()) return new Result(401, null, "Connect this device first");
+        for (int attempt = 0; attempt < 3; attempt++) {
+            Result remote = request("/v1/state", "GET", null, token);
+            if (!remote.ok()) return remote;
+            JSONObject remoteState = remote.data.optJSONObject("state");
+            if (remoteState == null) return new Result(502, null, "Invalid sync response");
+            Set<String> dirty = dirtyKeys();
+            if (dirty.isEmpty()) {
+                prefs.edit().putString("state", remoteState.toString())
+                        .putLong("revision", remote.data.optLong("revision", 0)).apply();
+                return new Result(200, remote.data, "Synchronized");
+            }
+            String uploadedLocalSnapshot = state().toString();
+            JSONObject merged = merge(remoteState, new JSONObject(uploadedLocalSnapshot), dirty);
+            JSONObject upload = new JSONObject().put("revision", remote.data.optLong("revision", 0))
+                    .put("state", merged);
+            Result saved = request("/v1/state", "PUT", upload, token);
+            if (saved.ok()) {
+                // Never clear edits that happened while this network request was running.
+                if (dirty.equals(dirtyKeys()) && state().toString().equals(uploadedLocalSnapshot)) {
+                    prefs.edit().putString("state", merged.toString()).remove("dirty")
+                            .putLong("revision", saved.data.optLong("revision", 0)).apply();
+                }
+                return new Result(200, saved.data, "Synchronized");
+            }
+            if (saved.code != 409) return saved;
+        }
+        return new Result(409, null, "Another device changed settings. Retry sync.");
+    }
+
+    private Set<String> dirtyKeys() {
+        Set<String> keys = new HashSet<>();
+        JSONArray dirty = parseArray(prefs.getString("dirty", "[]"));
+        for (int i = 0; i < dirty.length(); i++) {
+            String key = dirty.optString(i, "");
+            if (!key.isEmpty()) keys.add(key);
+        }
+        return keys;
+    }
+
+    private static JSONArray parseArray(String json) {
+        try { return new JSONArray(json); } catch (Exception ignored) { return new JSONArray(); }
+    }
+
+    private void saveEdited(JSONObject state, String editedKey) {
+        Set<String> dirty = dirtyKeys();
+        dirty.add(editedKey);
+        prefs.edit().putString("state", state.toString())
+                .putString("dirty", new JSONArray(dirty).toString()).apply();
+    }
+
+    public void setSourceFilter(String filter) {
+        if (!"youtube".equals(filter) && !"rumble".equals(filter) && !"both".equals(filter)) return;
+        JSONObject value = state();
+        try { value.put("sourceFilter", filter); saveEdited(value, "sourceFilter"); }
+        catch (Exception ignored) { }
+    }
+
+    public JSONArray followedChannels() {
+        JSONArray source = state().optJSONArray("channels");
+        JSONArray selected = new JSONArray();
+        if (source != null) for (int i = 0; i < source.length(); i++) {
+            JSONObject channel = source.optJSONObject(i);
+            if (channel != null && "rumble".equals(channel.optString("provider")) &&
+                    channel.optBoolean("subscribed")) selected.put(channel);
+        }
+        return selected;
+    }
+
+    public boolean isFollowed(String id) {
+        JSONArray channels = followedChannels();
+        for (int i = 0; i < channels.length(); i++) {
+            if (id.equals(channels.optJSONObject(i).optString("id"))) return true;
+        }
+        return false;
+    }
+
+    public void follow(String id, String name, boolean subscribed) {
+        if (id == null || id.isEmpty() || id.length() > 200) return;
+        JSONObject value = state();
+        JSONArray channels = value.optJSONArray("channels");
+        if (channels == null) channels = new JSONArray();
+        JSONArray updated = new JSONArray();
+        int order = channels.length();
+        for (int i = 0; i < channels.length(); i++) {
+            JSONObject entry = channels.optJSONObject(i);
+            if (entry == null) continue;
+            if (id.equals(entry.optString("id")) && "rumble".equals(entry.optString("provider"))) {
+                order = entry.optInt("order", i);
+            } else updated.put(entry);
+        }
+        try {
+            updated.put(new JSONObject().put("provider", "rumble").put("id", id)
+                    .put("name", name == null || name.trim().isEmpty() ? id : name.substring(0, Math.min(200, name.length())))
+                    .put("subscribed", subscribed).put("order", order));
+            value.put("channels", updated);
+            saveEdited(value, "channel:" + id);
+            updateRumbleSidebar();
+        } catch (Exception ignored) { }
+    }
+
+    public void moveFollowedChannel(String id, int direction) {
+        JSONObject value = state();
+        JSONArray source = value.optJSONArray("channels");
+        if (source == null || source.length() < 2) return;
+        java.util.ArrayList<JSONObject> ordered = new java.util.ArrayList<>();
+        for (int i = 0; i < source.length(); i++) {
+            JSONObject entry = source.optJSONObject(i);
+            if (entry != null) ordered.add(entry);
+        }
+        java.util.Collections.sort(ordered, (a, b) -> Integer.compare(a.optInt("order"), b.optInt("order")));
+        int index = -1;
+        for (int i = 0; i < ordered.size(); i++) if (id.equals(ordered.get(i).optString("id"))) index = i;
+        int next = index + direction;
+        if (index < 0 || next < 0 || next >= ordered.size()) return;
+        java.util.Collections.swap(ordered, index, next);
+        JSONArray rewritten = new JSONArray();
+        for (int i = 0; i < ordered.size(); i++) {
+            JSONObject entry = ordered.get(i);
+            try { entry.put("order", i); } catch (Exception ignored) { }
+            rewritten.put(entry);
+        }
+        try {
+            value.put("channels", rewritten);
+            Set<String> dirty = dirtyKeys();
+            dirty.add("channel:" + ordered.get(index).optString("id"));
+            dirty.add("channel:" + ordered.get(next).optString("id"));
+            prefs.edit().putString("state", value.toString())
+                    .putString("dirty", new JSONArray(dirty).toString()).apply();
+            updateRumbleSidebar();
+        } catch (Exception ignored) { }
+    }
+
+    private void updateRumbleSidebar() {
+        JSONObject value = state();
+        JSONArray existing = value.optJSONArray("sidebar");
+        JSONArray sidebar = new JSONArray();
+        if (existing != null) for (int i = 0; i < existing.length(); i++) {
+            JSONObject entry = existing.optJSONObject(i);
+            if (entry != null && !"rumble".equals(entry.optString("provider"))) sidebar.put(entry);
+        }
+        JSONArray followed = followedChannels();
+        for (int i = 0; i < followed.length(); i++) {
+            JSONObject channel = followed.optJSONObject(i);
+            if (channel == null) continue;
+            try { sidebar.put(new JSONObject().put("provider", "rumble")
+                    .put("id", channel.optString("id"))
+                    .put("label", channel.optString("name"))
+                    .put("order", channel.optInt("order", i))
+                    .put("pinned", true)); }
+            catch (Exception ignored) { }
+        }
+        saveSidebar(sidebar);
+    }
+
+    /** Does not rewrite the native SmartTube sidebar or touch its YouTube credentials. */
+    public void saveSidebar(JSONArray sidebar) {
+        JSONObject value = state();
+        try { value.put("sidebar", sidebar); saveEdited(value, "sidebar"); }
+        catch (Exception ignored) { }
+    }
+
+    public long resumePosition(String id) {
+        JSONArray progress = state().optJSONArray("progress");
+        if (progress != null) for (int i = 0; i < progress.length(); i++) {
+            JSONObject item = progress.optJSONObject(i);
+            if (item != null && "rumble".equals(item.optString("provider")) && id.equals(item.optString("id")))
+                return item.optLong("positionMs", 0);
+        }
+        return 0;
+    }
+
+    public void saveProgress(String id, long positionMs, long durationMs) {
+        if (id == null || id.isEmpty() || positionMs < 0 || durationMs <= 0) return;
+        JSONObject value = state();
+        JSONArray progress = value.optJSONArray("progress");
+        JSONArray updated = new JSONArray();
+        if (progress != null) for (int i = 0; i < progress.length(); i++) {
+            JSONObject item = progress.optJSONObject(i);
+            if (item != null && !("rumble".equals(item.optString("provider")) && id.equals(item.optString("id"))))
+                updated.put(item);
+        }
+        try {
+            updated.put(new JSONObject().put("provider", "rumble").put("id", id)
+                    .put("positionMs", positionMs).put("durationMs", durationMs)
+                    .put("updatedAtMs", System.currentTimeMillis()));
+            value.put("progress", updated);
+            saveEdited(value, "progress:" + id);
+        } catch (Exception ignored) { }
+    }
+
+    private static JSONObject merge(JSONObject server, JSONObject local, Set<String> dirty) throws Exception {
+        JSONObject output = new JSONObject(server.toString());
+        if (dirty.contains("sourceFilter")) output.put("sourceFilter", local.optString("sourceFilter", "both"));
+        JSONArray remoteChannels = server.optJSONArray("channels");
+        JSONArray localChannels = local.optJSONArray("channels");
+        JSONArray channels = new JSONArray();
+        if (remoteChannels != null) for (int i = 0; i < remoteChannels.length(); i++) {
+            JSONObject item = remoteChannels.optJSONObject(i);
+            if (item != null && !dirty.contains("channel:" + item.optString("id"))) channels.put(item);
+        }
+        if (localChannels != null) for (int i = 0; i < localChannels.length(); i++) {
+            JSONObject item = localChannels.optJSONObject(i);
+            if (item != null && dirty.contains("channel:" + item.optString("id"))) channels.put(item);
+        }
+        output.put("channels", channels);
+        if (dirty.contains("sidebar")) output.put("sidebar", local.optJSONArray("sidebar"));
+        JSONArray combinedProgress = new JSONArray();
+        JSONObject newest = new JSONObject();
+        for (JSONArray source : new JSONArray[]{server.optJSONArray("progress"), local.optJSONArray("progress")}) {
+            if (source == null) continue;
+            for (int i = 0; i < source.length(); i++) {
+                JSONObject item = source.optJSONObject(i);
+                if (item == null) continue;
+                String key = item.optString("provider") + ":" + item.optString("id");
+                JSONObject previous = newest.optJSONObject(key);
+                if (previous == null || item.optLong("updatedAtMs") > previous.optLong("updatedAtMs")) newest.put(key, item);
+            }
+        }
+        for (java.util.Iterator<String> keys = newest.keys(); keys.hasNext(); ) combinedProgress.put(newest.getJSONObject(keys.next()));
+        output.put("progress", combinedProgress);
+        return output;
+    }
+
+    public void rumbleSearch(String query, Callback done) {
+        enqueue(() -> request("/v1/rumble/search?q=" + java.net.URLEncoder.encode(query, "UTF-8"),
+                "GET", null, prefs.getString("token", "")), done);
+    }
+
+    public void rumbleLive(Callback done) {
+        enqueue(() -> request("/v1/rumble/live", "GET", null, prefs.getString("token", "")), done);
+    }
+
+    public void rumbleHome(Callback done) {
+        rumbleHome(true, done);
+    }
+
+    public void rumbleHome(boolean includeLive, Callback done) {
+        enqueue(() -> {
+            String token = prefs.getString("token", "");
+            if (token.isEmpty()) return new Result(401, null, "Connect this device in Rumble sync settings");
+            JSONArray channels = followedChannels();
+            if (channels.length() == 0 && includeLive) return request("/v1/rumble/live", "GET", null, token);
+
+            JSONArray videos = new JSONArray();
+            Set<String> seen = new HashSet<>();
+            Result failure = null;
+            for (int i = 0; i < Math.min(10, channels.length()); i++) {
+                JSONObject channel = channels.optJSONObject(i);
+                String id = channel == null ? "" : channel.optString("id");
+                if (id.isEmpty()) continue;
+                String url = id.startsWith("https://rumble.com/") ? id :
+                        "https://rumble.com/c/" + id.replaceAll("[^A-Za-z0-9_-]", "");
+                Result feed;
+                try {
+                    feed = request(rumbleChannelPath(url), "GET", null, token);
+                } catch (Exception error) {
+                    failure = new Result(0, null, "Couldn't reach the Rumble server");
+                    continue;
+                }
+                if (!feed.ok()) {
+                    failure = feed;
+                    if (feed.code == 401 || feed.code == 429) break;
+                    continue;
+                }
+                JSONArray items = feed.data.optJSONArray("videos");
+                if (items == null) continue;
+                for (int j = 0; j < items.length(); j++) {
+                    JSONObject item = items.optJSONObject(j);
+                    if (item != null && seen.add(item.optString("id"))) {
+                        if (item.optString("channelName").isEmpty()) {
+                            JSONObject profile = feed.data.optJSONObject("channel");
+                            String name = profile == null ? "" : profile.optString("name");
+                            item.put("channelName", name.isEmpty() ? channel.optString("name") : name);
+                        }
+                        videos.put(item);
+                    }
+                }
+            }
+            return videos.length() == 0 && failure != null ? failure :
+                    new Result(200, new JSONObject().put("videos", videos), "OK");
+        }, done);
+    }
+
+    private static String rumbleChannelPath(String url) throws java.io.UnsupportedEncodingException {
+        return "/v1/rumble/channel?url=" + java.net.URLEncoder.encode(url, "UTF-8");
+    }
+
+    public void rumbleChannel(String channelUrl, Callback done) {
+        enqueue(() -> request(rumbleChannelPath(channelUrl),
+                "GET", null, prefs.getString("token", "")), done);
+    }
+
+    /** Video details are fetched on demand: search results contain no playable streams. */
+    public void rumbleVideo(String videoUrl, Callback done) {
+        enqueue(() -> request("/v1/rumble/video?url=" + java.net.URLEncoder.encode(videoUrl, "UTF-8"),
+                "GET", null, prefs.getString("token", "")), done);
+    }
+}
