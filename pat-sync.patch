+    private static String channelUrl(String id) {
+        if (id.startsWith("https://rumble.com/c/") || id.startsWith("https://rumble.com/user/")) return id;
+        return "https://rumble.com/c/" + id.replaceAll("[^a-zA-Z0-9_-]", "");
+    }
+
+    private void followChannelUrl() {
+        EditText input = new EditText(this);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        input.setHint("https://rumble.com/c/channel");
+        new AlertDialog.Builder(this).setTitle("Follow Rumble channel")
+                .setView(input).setNegativeButton("Cancel", null)
+                .setPositiveButton("Follow", (dialog, which) -> {
+                    String entered = input.getText().toString().trim();
+                    if (!entered.matches("https://rumble\\.com/(c|user)/[A-Za-z0-9_-]{2,100}/?")) {
+                        toast("Enter a Rumble channel URL (rumble.com/c/...)"); return;
+                    }
+                    entered = entered.replaceAll("/$", "");
+                    sync.follow(entered, entered.substring(entered.lastIndexOf('/') + 1), true);
+                    if (sync.paired()) sync.syncNow(null);
+                    selectedChannel = entered;
+                    refreshSidebar();
+                    loadFeed();
+                }).show();
+    }
