@@ -0,0 +1,247 @@
+package com.liskovsoft.smartyoutubetv2.mobile.sync;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.google.android.exoplayer2.DefaultLoadControl;
+import com.google.android.exoplayer2.ExoPlaybackException;
+import com.google.android.exoplayer2.ExoPlayerFactory;
+import com.google.android.exoplayer2.Player;
+import com.google.android.exoplayer2.SimpleExoPlayer;
+import com.google.android.exoplayer2.source.ExtractorMediaSource;
+import com.google.android.exoplayer2.source.MediaSource;
+import com.google.android.exoplayer2.source.hls.HlsMediaSource;
+import com.google.android.exoplayer2.ui.PlayerView;
+import com.google.android.exoplayer2.upstream.DefaultHttpDataSourceFactory;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+
+/** A proper TV-remote + touchscreen Rumble player, separate from YouTube's extractor. */
+public final class PatRumblePlayerActivity extends Activity {
+    public static final String EXTRA_VIDEO = "rumble_video";
+    private static final int WHITE = Color.WHITE;
+    private final Handler timer = new Handler(Looper.getMainLooper());
+    private final ArrayList<String> streams = new ArrayList<>();
+    private final Runnable checkStall = () -> switchStream("Stream stalled. Trying another quality");
+    private final Runnable savePosition = new Runnable() {
+        @Override public void run() {
+            storeProgress();
+            timer.postDelayed(this, 12_000);
+        }
+    };
+
+    private PatSyncClient sync;
+    private SimpleExoPlayer player;
+    private PlayerView view;
+    private Button follow;
+    private TextView loading;
+    private JSONObject video;
+    private int streamIndex;
+    private int retries;
+    private long resumeMs;
+    private boolean active;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        sync = new PatSyncClient(this);
+        try { video = new JSONObject(getIntent().getStringExtra(EXTRA_VIDEO)); }
+        catch (Exception ignored) { finish(); return; }
+        collectStreams();
+        resumeMs = sync.resumePosition(video.optString("id"));
+
+        LinearLayout page = new LinearLayout(this);
+        page.setOrientation(LinearLayout.VERTICAL);
+        page.setBackgroundColor(Color.BLACK);
+        LinearLayout header = new LinearLayout(this);
+        header.setGravity(Gravity.CENTER_VERTICAL);
+        header.setPadding(dp(12), dp(7), dp(12), dp(7));
+        TextView heading = new TextView(this);
+        heading.setText(video.optString("title", "Rumble"));
+        heading.setTextColor(WHITE);
+        heading.setTextSize(17);
+        heading.setMaxLines(2);
+        header.addView(heading, new LinearLayout.LayoutParams(0, -2, 1));
+        follow = new Button(this);
+        follow.setAllCaps(false);
+        follow.setOnClickListener(v -> toggleFollow());
+        header.addView(follow, new LinearLayout.LayoutParams(-2, -2));
+        updateFollow();
+        page.addView(header, new LinearLayout.LayoutParams(-1, -2));
+
+        FrameLayout playerHolder = new FrameLayout(this);
+        view = new PlayerView(this);
+        view.setUseController(true);
+        playerHolder.addView(view, new FrameLayout.LayoutParams(-1, -1));
+        loading = new TextView(this);
+        loading.setText(streams.isEmpty() ? "Loading Rumble video…" : "Preparing player…");
+        loading.setTextColor(WHITE);
+        loading.setTextSize(19);
+        loading.setGravity(Gravity.CENTER);
+        playerHolder.addView(loading, new FrameLayout.LayoutParams(-1, -1));
+        page.addView(playerHolder, new LinearLayout.LayoutParams(-1, 0, 1));
+        setContentView(page);
+        if (streams.isEmpty()) resolveVideo();
+    }
+
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    private void addStream(String value, HashSet<String> seen) {
+        try {
+            Uri uri = Uri.parse(value);
+            if ("https".equalsIgnoreCase(uri.getScheme()) && uri.getHost() != null &&
+                    !uri.getPath().endsWith(".tar") && seen.add(value))
+                streams.add(value);
+        } catch (Exception ignored) { }
+    }
+
+    private void collectStreams() {
+        streams.clear();
+        HashSet<String> unique = new HashSet<>();
+        addStream(video.optString("streamUrl"), unique);
+        JSONArray files = video.optJSONArray("files");
+        if (files != null) for (int i = 0; i < files.length(); i++) {
+            JSONObject file = files.optJSONObject(i);
+            if (file != null) addStream(file.optString("url"), unique);
+        }
+    }
+
+    private void resolveVideo() {
+        String url = video.optString("url", "");
+        if (!url.startsWith("https://rumble.com/")) {
+            loading.setText("Rumble video URL unavailable");
+            return;
+        }
+        sync.rumbleVideo(url, result -> {
+            if (isFinishing() || isDestroyed()) return;
+            JSONObject details = result.data.optJSONObject("video");
+            if (!result.ok() || details == null) {
+                loading.setText("Couldn't load Rumble video: " + result.message);
+                return;
+            }
+            try {
+                // Retain search-card metadata if a detail response omits fields.
+                for (java.util.Iterator<String> keys = details.keys(); keys.hasNext(); ) {
+                    String key = keys.next();
+                    if (!details.isNull(key)) video.put(key, details.opt(key));
+                }
+            } catch (Exception ignored) { }
+            collectStreams();
+            updateFollow();
+            if (streams.isEmpty()) loading.setText("No playable Rumble stream available");
+            else if (active && player == null) createPlayer();
+        });
+    }
+
+    private void createPlayer() {
+        loading.setVisibility(View.GONE);
+        DefaultLoadControl load = new DefaultLoadControl.Builder()
+                .setBufferDurationsMs(30_000, 90_000, 3_000, 7_000).createDefaultLoadControl();
+        player = ExoPlayerFactory.newSimpleInstance(this, new com.google.android.exoplayer2.DefaultRenderersFactory(this),
+                new com.google.android.exoplayer2.trackselection.DefaultTrackSelector(), load);
+        view.setPlayer(player);
+        player.addListener(new Player.EventListener() {
+            @Override public void onPlayerStateChanged(boolean playWhenReady, int state) {
+                timer.removeCallbacks(checkStall);
+                if (state == Player.STATE_BUFFERING && playWhenReady) timer.postDelayed(checkStall, 12_000);
+                if (state == Player.STATE_READY) retries = 0;
+                if (state == Player.STATE_ENDED) storeProgress();
+            }
+            @Override public void onPlayerError(ExoPlaybackException error) {
+                timer.removeCallbacks(checkStall);
+                switchStream("Rumble stream failed. Trying another quality");
+            }
+        });
+        playStream(0);
+        timer.postDelayed(savePosition, 12_000);
+    }
+
+    private void playStream(int index) {
+        if (player == null) return;
+        String url = streams.get(index);
+        DefaultHttpDataSourceFactory network = new DefaultHttpDataSourceFactory("SmartTube-Pat-Rumble/1");
+        Uri uri = Uri.parse(url);
+        MediaSource source = url.contains(".m3u8") || url.toLowerCase().contains("hls")
+                ? new HlsMediaSource.Factory(network).createMediaSource(uri)
+                : new ExtractorMediaSource.Factory(network).createMediaSource(uri);
+        player.prepare(source);
+        if (resumeMs > 0) player.seekTo(resumeMs);
+        player.setPlayWhenReady(true);
+    }
+
+    private void switchStream(String message) {
+        if (player == null) return;
+        timer.removeCallbacks(checkStall);
+        retries++;
+        resumeMs = Math.max(0, player.getCurrentPosition());
+        if (streamIndex + 1 < streams.size()) {
+            streamIndex++;
+            Toast.makeText(this, message, Toast.LENGTH_SHORT).show();
+            playStream(streamIndex);
+        } else if (retries <= 2) {
+            streamIndex = 0;
+            playStream(streamIndex);
+        } else {
+            Toast.makeText(this, "Rumble isn't delivering this video. Try again later.", Toast.LENGTH_LONG).show();
+            player.setPlayWhenReady(false);
+        }
+    }
+
+    private void updateFollow() {
+        String id = video.optString("channelUrl", "");
+        if (id.isEmpty()) id = video.optString("channelId", "");
+        follow.setVisibility(id.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE);
+        follow.setText(sync.isFollowed(id) ? "✓ Following" : "+ Follow channel");
+    }
+
+    private void toggleFollow() {
+        String id = video.optString("channelUrl", "");
+        if (id.isEmpty()) id = video.optString("channelId", "");
+        if (id.isEmpty()) return;
+        sync.follow(id, video.optString("channelName", id), !sync.isFollowed(id));
+        updateFollow();
+        if (sync.paired()) sync.syncNow(null);
+    }
+
+    private void storeProgress() {
+        if (player == null) return;
+        long duration = player.getDuration();
+        long position = player.getCurrentPosition();
+        if (position >= 0 && duration > 0 && duration < 86_400_000)
+            sync.saveProgress(video.optString("id"), Math.min(position, duration), duration);
+    }
+
+    @Override protected void onStart() {
+        super.onStart();
+        active = true;
+        if (player == null && view != null && !streams.isEmpty()) {
+            resumeMs = sync.resumePosition(video.optString("id"));
+            createPlayer();
+        }
+    }
+
+    @Override protected void onStop() {
+        active = false;
+        timer.removeCallbacks(checkStall);
+        timer.removeCallbacks(savePosition);
+        storeProgress();
+        if (player != null) { view.setPlayer(null); player.release(); player = null; }
+        if (sync.paired()) sync.syncNow(null);
+        super.onStop();
+    }
+}
