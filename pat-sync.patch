@@ -0,0 +1,57 @@
+package com.liskovsoft.smartyoutubetv2.mobile.sync;
+
+import android.content.Context;
+import android.content.Intent;
+
+import com.liskovsoft.sharedutils.helpers.DateHelper;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class PatRumbleCards {
+    private static final String PREFIX = "rumble:";
+
+    private PatRumbleCards() { }
+
+    public static List<Video> from(JSONObject payload, PatSyncClient sync) {
+        List<Video> cards = new ArrayList<>();
+        JSONArray results = payload.optJSONArray("videos");
+        if (results == null) return cards;
+        for (int i = 0; i < results.length(); i++) {
+            JSONObject item = results.optJSONObject(i);
+            if (item == null || item.optString("url").isEmpty()) continue;
+            String id = item.optString("id");
+            if (id.isEmpty()) continue;
+            Video card = new Video();
+            card.videoId = PREFIX + id;
+            card.title = item.optString("title");
+            String channel = item.optString("channelName").trim();
+            card.author = channel.isEmpty() ? "Rumble" : channel;
+            card.cardImageUrl = item.optString("thumbnail");
+            card.publishedAtMs = PatRecentUploads.parseDate(item.optString("publishedAt"));
+            String subtitle = channel.isEmpty() ? "Rumble" : channel + " • Rumble";
+            if (card.publishedAtMs > 0) subtitle += " • " + DateHelper.toShortDate(card.publishedAtMs, true, false, false);
+            card.secondTitle = subtitle;
+            card.isLive = item.optBoolean("live", false);
+            card.description = item.toString();
+            long duration = item.optLong("durationMs", 0);
+            long resume = sync.resumePosition(id);
+            if (duration > 0 && resume > 0) card.percentWatched = 100f * resume / duration;
+            cards.add(card);
+        }
+        return cards;
+    }
+
+    public static boolean isRumble(Video video) {
+        return video.videoId != null && video.videoId.startsWith(PREFIX);
+    }
+
+    public static void open(Context context, Video card) {
+        context.startActivity(new Intent(context, PatRumblePlayerActivity.class)
+                .putExtra(PatRumblePlayerActivity.EXTRA_VIDEO, card.description));
+    }
+}
