+
+/**
+ * One video-card format for both providers, touchscreen and D-pad navigation.
+ * This also exposes phone-side Bunny authorization and TV code-only pairing.
+ */
+public final class PatHubActivity extends Activity {
+    private static final int BG = Color.rgb(16, 16, 16);
+    private static final int PANEL = Color.rgb(34, 34, 34);
+    private static final int RED = Color.rgb(234, 35, 35);
+    private static final int WHITE = Color.WHITE;
+
+    private final CompositeDisposable actions = new CompositeDisposable();
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private final List<Item> youtube = new ArrayList<>();
+    private final List<Item> rumble = new ArrayList<>();
+    private final List<Item> visible = new ArrayList<>();
+    private PatSyncClient sync;
+    private RecyclerView cards;
+    private CardAdapter adapter;
+    private TextView info;
+    private LinearLayout sidebar;
+    private EditText searchBox;
+    private Button ytButton;
+    private Button rumbleButton;
+    private Button bothButton;
+    private boolean tv;
+    private boolean subscriptions;
+    private String query = "";
+    private String selectedChannel = "";
+    private int generation;
+    private int pending;
+
+    private static final class Item {
+        final Video youtube;
+        final JSONObject rumble;
+        Item(Video value) { youtube = value; rumble = null; }
+        Item(JSONObject value) { youtube = null; rumble = value; }
+        boolean isRumble() { return rumble != null; }
+        String title() { return isRumble() ? rumble.optString("title") : youtube.title; }
+        String thumbnail() { return isRumble() ? rumble.optString("thumbnail") : youtube.cardImageUrl; }
+        String channel() { return isRumble() ? rumble.optString("channelName", "Rumble") : youtube.getAuthor(); }
+    }
+
+    /** Keeps the top of portrait thumbnails visible instead of centering the crop. */
+    private static final class TopCropView extends ImageView {
+        private final Matrix crop = new Matrix();
+        TopCropView(android.content.Context context) {
+            super(context);
+            setScaleType(ScaleType.MATRIX);
+        }
+        @Override public void setImageDrawable(Drawable drawable) {
+            super.setImageDrawable(drawable);
+            if (crop != null) updateCrop();
+        }
+        @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+            super.onSizeChanged(w, h, oldw, oldh);
+            updateCrop();
+        }
+        private void updateCrop() {
+            Drawable source = getDrawable();
+            if (source != null && getWidth() > 0 && getHeight() > 0 &&
+                    source.getIntrinsicWidth() > 0 && source.getIntrinsicHeight() > 0) {
+                float scale = Math.max((float) getWidth() / source.getIntrinsicWidth(),
+                        (float) getHeight() / source.getIntrinsicHeight());
+                crop.reset();
+                crop.setScale(scale, scale);
+                crop.postTranslate((getWidth() - source.getIntrinsicWidth() * scale) / 2, 0);
+                setImageMatrix(crop);
+            }
+        }
+    }
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        tv = getPackageName().equals("app.smarttube.pattv");
+        sync = new PatSyncClient(this);
+        buildUi();
+        if (sync.paired()) sync.syncNow(result -> { if (result.ok()) loadFeed(); });
+        loadFeed();
+    }
+
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    private Button action(String label, Runnable run) {
+        Button button = new Button(this);
+        button.setAllCaps(false);
+        button.setText(label);
+        button.setTextColor(WHITE);
+        button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(PANEL));
+        button.setOnClickListener(v -> run.run());
+        button.setFocusable(true);
+        return button;
+    }
+
+    private void buildUi() {
+        LinearLayout root = new LinearLayout(this);
+        root.setBackgroundColor(BG);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(tv ? 24 : 8), dp(tv ? 16 : 5), dp(tv ? 24 : 8), dp(8));
+
+        LinearLayout nav = new LinearLayout(this);
+        nav.setGravity(Gravity.CENTER_VERTICAL);
+        TextView title = new TextView(this);
+        title.setText("PatTube");
+        title.setTextSize(tv ? 25 : 21);
+        title.setTextColor(WHITE);
+        title.setTypeface(null, 1);
+        nav.addView(title, new LinearLayout.LayoutParams(0, -2, 1));
+        nav.addView(action("Sync", this::showSyncDialog), new LinearLayout.LayoutParams(-2, -2));
+        root.addView(nav, new LinearLayout.LayoutParams(-1, -2));
+
+        LinearLayout providers = new LinearLayout(this);
+        providers.setGravity(Gravity.CENTER_VERTICAL);
+        ytButton = action("YouTube", () -> chooseProvider("youtube"));
+        rumbleButton = action("Rumble", () -> chooseProvider("rumble"));
+        bothButton = action("Both", () -> chooseProvider("both"));
+        for (Button button : new Button[]{ytButton, rumbleButton, bothButton})
+            providers.addView(button, new LinearLayout.LayoutParams(0, dp(tv ? 58 : 48), 1));
+        root.addView(providers, new LinearLayout.LayoutParams(-1, -2));
+
+        LinearLayout controls = new LinearLayout(this);
+        controls.addView(action("Home", () -> { subscriptions = false; query = ""; selectedChannel = ""; loadFeed(); }),
+                new LinearLayout.LayoutParams(-2, dp(48)));
+        controls.addView(action("Subs", () -> { subscriptions = true; query = ""; selectedChannel = ""; loadFeed(); }),
+                new LinearLayout.LayoutParams(-2, dp(48)));
+        searchBox = new EditText(this);
+        searchBox.setSingleLine(true);
+        searchBox.setHint("Search videos");
+        searchBox.setHintTextColor(Color.GRAY);
+        searchBox.setTextColor(WHITE);
+        searchBox.setTextSize(16);
+        searchBox.setImeOptions(android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH);
+        searchBox.setOnEditorActionListener((v, actionId, event) -> {
+            query = searchBox.getText().toString().trim();
+            selectedChannel = "";
+            loadFeed();
+            return true;
+        });
+        controls.addView(searchBox, new LinearLayout.LayoutParams(0, dp(48), 1));
+        controls.addView(action("Go", () -> {
+            query = searchBox.getText().toString().trim();
+            selectedChannel = "";
+            loadFeed();
+        }), new LinearLayout.LayoutParams(-2, dp(48)));
+        root.addView(controls, new LinearLayout.LayoutParams(-1, -2));
+
+        info = new TextView(this);
+        info.setTextColor(Color.LTGRAY);
+        info.setTextSize(14);
+        info.setPadding(dp(8), dp(5), dp(8), dp(5));
+        root.addView(info, new LinearLayout.LayoutParams(-1, -2));
+
+        LinearLayout body = new LinearLayout(this);
+        body.setOrientation(LinearLayout.HORIZONTAL);
+        if (tv) {
+            ScrollView scroll = new ScrollView(this);
+            sidebar = new LinearLayout(this);
+            sidebar.setOrientation(LinearLayout.VERTICAL);
+            scroll.addView(sidebar);
+            body.addView(scroll, new LinearLayout.LayoutParams(dp(220), -1));
+        }
+        cards = new RecyclerView(this);
+        cards.setClipToPadding(false);
+        cards.setPadding(dp(4), dp(5), dp(4), dp(20));
+        cards.setLayoutManager(new GridLayoutManager(this, tv ? 4 :
+                (getResources().getDisplayMetrics().widthPixels / getResources().getDisplayMetrics().density > 600 ? 3 : 2)));
+        adapter = new CardAdapter();
+        cards.setAdapter(adapter);
+        body.addView(cards, new LinearLayout.LayoutParams(0, -1, 1));
+        root.addView(body, new LinearLayout.LayoutParams(-1, 0, 1));
+        setContentView(root);
+        refreshSidebar();
+    }
+
+    private void chooseProvider(String value) {
+        sync.setSourceFilter(value);
+        if (sync.paired()) sync.syncNow(null);
+        loadFeed();
+    }
+
+    private void updateButtons() {
+        String selected = sync.sourceFilter();
+        for (Button button : new Button[]{ytButton, rumbleButton, bothButton}) {
+            String mode = button == ytButton ? "youtube" : button == rumbleButton ? "rumble" : "both";
+            button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(mode.equals(selected) ? RED : PANEL));
+        }
+    }
+
+    private void refreshSidebar() {
+        if (sidebar == null) return;
+        sidebar.removeAllViews();
+        sidebar.addView(action("My Rumble channels", () -> { subscriptions = true; query = ""; selectedChannel = ""; loadFeed(); }));
+        sidebar.addView(action("+ Follow URL", this::followChannelUrl));
+        JSONArray followed = sync.followedChannels();
+        List<JSONObject> ordered = new ArrayList<>();
+        for (int i = 0; i < followed.length(); i++) {
+            JSONObject channel = followed.optJSONObject(i);
+            if (channel != null) ordered.add(channel);
+        }
+        Collections.sort(ordered, Comparator.comparingInt(a -> a.optInt("order")));
+        for (JSONObject channel : ordered) {
+            String id = channel.optString("id");
+            String label = channel.optString("name", id);
+            Button button = action(label, () -> {
+                selectedChannel = channelUrl(id);
+                query = "";
+                loadFeed();
+            });
+            button.setOnLongClickListener(v -> {
+                sync.moveFollowedChannel(id, -1);
+                sync.syncNow(null);
+                refreshSidebar();
+                return true;
+            });
+            sidebar.addView(button, new LinearLayout.LayoutParams(-1, dp(60)));
+        }
+        // Follow/unfollow/reorder writes the Rumble sidebar to Bunny.
+        // This menu leaves SmartTube's native YouTube sidebar untouched.
+    }
+
+    private static String channelUrl(String id) {
+        if (id.startsWith("https://rumble.com/c/") || id.startsWith("https://rumble.com/user/")) return id;
+        return "https://rumble.com/c/" + id.replaceAll("[^a-zA-Z0-9_-]", "");
+    }
+
+    private void followChannelUrl() {
+        EditText input = new EditText(this);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        input.setHint("https://rumble.com/c/channel");
+        new AlertDialog.Builder(this).setTitle("Follow Rumble channel")
+                .setView(input).setNegativeButton("Cancel", null)
+                .setPositiveButton("Follow", (dialog, which) -> {
+                    String entered = input.getText().toString().trim();
+                    if (!entered.matches("https://rumble\\.com/(c|user)/[A-Za-z0-9_-]{2,100}/?")) {
+                        toast("Enter a Rumble channel URL (rumble.com/c/...)"); return;
+                    }
+                    entered = entered.replaceAll("/$", "");
+                    sync.follow(entered, entered.substring(entered.lastIndexOf('/') + 1), true);
+                    if (sync.paired()) sync.syncNow(null);
+                    selectedChannel = entered;
+                    refreshSidebar();
+                    loadFeed();
+                }).show();
+    }
+
+    private void loadFeed() {
+        actions.clear();
+        int serial = ++generation;
+        youtube.clear();
+        rumble.clear();
+        visible.clear();
+        adapter.notifyDataSetChanged();
+        updateButtons();
+        refreshSidebar();
+        String filter = sync.sourceFilter();
+        boolean showYoutube = !"rumble".equals(filter) && selectedChannel.isEmpty();
+        boolean showRumble = !"youtube".equals(filter) || !selectedChannel.isEmpty();
+        pending = 0;
+        if (showYoutube) loadYoutube(serial);
+        if (showRumble) loadRumble(serial);
+        info.setText(pending > 0 ? "Loading " + filter + " videos…" : "No videos yet");
+    }
+
+    private void loadYoutube(int serial) {
+        pending++;
+        if (!query.isEmpty()) {
+            actions.add(YouTubeServiceManager.instance().getContentService()
+                    .getSearchObserve(query, SearchOptions.TYPE_VIDEO)
+                    .subscribe(groups -> runOnUiThread(() -> { addYoutube(groups, serial); done(serial); }),
+                            error -> runOnUiThread(() -> done(serial))));
+        } else if (subscriptions) {
+            actions.add(YouTubeServiceManager.instance().getContentService()
+                    .getSubscriptionsObserve()
+                    .subscribe(group -> runOnUiThread(() -> {
+                        addYoutube(Collections.singletonList(group), serial);
+                        done(serial);
+                    }), error -> runOnUiThread(() -> done(serial))));
+        } else {
+            actions.add(Observable.fromCallable(() -> YouTubeServiceManager.instance().getContentService().getHome())
+                    .subscribeOn(io.reactivex.schedulers.Schedulers.io())
+                    .subscribe(groups -> runOnUiThread(() -> { addYoutube(groups, serial); done(serial); }),
+                            error -> runOnUiThread(() -> done(serial))));
+        }
+    }
+
+    private void addYoutube(List<MediaGroup> groups, int serial) {
+        if (serial != generation || groups == null) return;
+        HashSet<String> ids = new HashSet<>();
+        for (Item current : youtube) if (current.youtube != null) ids.add(current.youtube.videoId);
+        for (MediaGroup group : groups) {
+            if (group == null || group.getType() == MediaGroup.TYPE_SHORTS) continue;
+            VideoGroup videos = VideoGroup.from(group);
+            if (videos == null || videos.getVideos() == null) continue;
+            for (Video video : videos.getVideos()) {
+                if (video != null && video.videoId != null && !video.isShorts && ids.add(video.videoId))
+                    youtube.add(new Item(video));
+            }
+        }
+        rebuild(serial);
+    }
+
+    private void loadRumble(int serial) {
+        if (!sync.paired()) return;
+        if (!selectedChannel.isEmpty()) {
+            pending++;
+            sync.rumbleChannel(selectedChannel, response -> appendRumble(response, serial));
+        } else if (!query.isEmpty()) {
+            pending++;
+            sync.rumbleSearch(query, response -> appendRumble(response, serial));
+        } else if (!subscriptions) {
+            pending++;
+            sync.rumbleHome(response -> appendRumble(response, serial));
+        } else {
+            JSONArray channels = sync.followedChannels();
+            int count = Math.min(10, channels.length());
+            for (int i = 0; i < count; i++) {
+                JSONObject channel = channels.optJSONObject(i);
+                if (channel == null) continue;
+                pending++;
+                sync.rumbleChannel(channelUrl(channel.optString("id")), response -> appendRumble(response, serial));
+            }
+        }
+    }
+
+    private void appendRumble(PatSyncClient.Result response, int serial) {
+        if (serial != generation) return;
+        if (response.ok()) {
+            JSONArray videos = response.data.optJSONArray("videos");
+            HashSet<String> ids = new HashSet<>();
+            for (Item current : rumble) ids.add(current.rumble.optString("id"));
+            if (videos != null) for (int i = 0; i < videos.length(); i++) {
+                JSONObject value = videos.optJSONObject(i);
+                if (value != null && ids.add(value.optString("id"))) rumble.add(new Item(value));
+            }
+        } else if ("rumble".equals(sync.sourceFilter()) || !selectedChannel.isEmpty()) {
+            toast(response.message);
+        }
+        rebuild(serial);
+        done(serial);
+    }
+
+    private void rebuild(int serial) {
+        if (serial != generation) return;
+        visible.clear();
+        if ("youtube".equals(sync.sourceFilter())) visible.addAll(youtube);
+        else if ("rumble".equals(sync.sourceFilter()) || !selectedChannel.isEmpty()) visible.addAll(rumble);
+        else {
+            // Same shape for both providers, with neither feed buried underneath the other.
+            int y = 0, r = 0;
+            while (y < youtube.size() || r < rumble.size()) {
+                for (int n = 0; n < 2 && y < youtube.size(); n++) visible.add(youtube.get(y++));
+                if (r < rumble.size()) visible.add(rumble.get(r++));
+            }
+        }
+        adapter.notifyDataSetChanged();
+        if (!visible.isEmpty()) info.setText(visible.size() + " videos • " + sync.sourceFilter());
+    }
+
+    private void done(int serial) {
+        if (serial != generation) return;
+        pending = Math.max(0, pending - 1);
+        if (pending == 0 && visible.isEmpty()) {
+            info.setText(sync.sourceFilter().equals("rumble") && sync.followedChannels().length() == 0 && query.isEmpty()
+                    ? "Follow a Rumble channel or use Search to see videos."
+                    : "No videos available. Check the connection or try Search.");
+        }
+    }
+
+    private void open(Item item) {
+        if (!item.isRumble()) PlaybackPresenter.instance(this).openVideo(item.youtube);
+        else startActivity(new Intent(this, PatRumblePlayerActivity.class)
+                .putExtra(PatRumblePlayerActivity.EXTRA_VIDEO, item.rumble.toString()));
+    }
+
+    private void toast(String value) { Toast.makeText(this, value, Toast.LENGTH_LONG).show(); }
+
+    private void showSyncDialog() {
+        if (!sync.paired()) {
+            if (tv) startTvPairing();
+            else startPhoneAuthorization();
+            return;
+        }
+        String[] choices = tv
+                ? new String[]{"Sync now", "Disconnect this TV"}
+                : new String[]{"Sync now", "Link Google TV", "Change Bunny server", "Disconnect this phone"};
+        new AlertDialog.Builder(this).setTitle("Bunny sync")
+                .setItems(choices, (dialog, index) -> {
+                    if (index == 0) sync.syncNow(result -> {
+                        toast(result.message);
+                        if (result.ok()) loadFeed();
+                    });
+                    else if (!tv && index == 1) approveTvPairing();
+                    else if (!tv && index == 2) promptServerUrl(() -> startPhoneAuthorization());
+                    else {
+                        sync.clearPairing();
+                        toast("Device disconnected");
+                    }
+                }).show();
+    }
+
+    private void promptServerUrl(Runnable onSaved) {
+        EditText server = new EditText(this);
+        server.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        server.setText(sync.endpoint());
+        server.setHint("https://your-edge-script.bunny...");
+        new AlertDialog.Builder(this).setTitle("Bunny Edge Script URL")
+                .setMessage("This is the public HTTPS endpoint, not the private database URL or token.")
+                .setView(server).setNegativeButton("Cancel", null)
+                .setPositiveButton("Continue", (dialog, which) -> {
+                    try { sync.configureEndpoint(server.getText().toString()); onSaved.run(); }
+                    catch (Exception error) { toast(error.getMessage()); }
+                }).show();
+    }
+
+    private void startPhoneAuthorization() {
+        // Phone can load an already-published endpoint from sync_config.json.
+        if (sync.endpoint().isEmpty()) {
+            promptServerUrl(this::askSetupCode);
+        } else askSetupCode();
+    }
+
+    private void askSetupCode() {
+        EditText code = new EditText(this);
+        code.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        code.setSingleLine(true);
+        new AlertDialog.Builder(this).setTitle("Authorize this phone")
+                .setMessage("Enter your Bunny sync setup code once. It is never stored or sent to the TV.")
+                .setView(code).setNegativeButton("Cancel", null)
+                .setPositiveButton("Connect", (dialog, which) -> sync.authorizePhone(code.getText().toString(), result -> {
+                    code.setText("");
+                    toast(result.message);
+                    if (result.ok()) loadFeed();
+                })).show();
+    }
+
+    private void approveTvPairing() {
+        EditText code = new EditText(this);
+        code.setInputType(InputType.TYPE_CLASS_NUMBER);
+        code.setSingleLine(true);
+        code.setHint("10-digit code on TV");
+        new AlertDialog.Builder(this).setTitle("Link TV to your Bunny account")
+                .setView(code).setNegativeButton("Cancel", null)
+                .setPositiveButton("Approve", (dialog, which) ->
+                        sync.approvePairing(code.getText().toString(), result -> toast(result.message)))
+                .show();
+    }
+
+    private void startTvPairing() {
+        sync.startPairing(result -> {
+            if (!result.ok()) { toast(result.message); return; }
+            String code = result.data.optString("code");
+            final boolean[] open = {true};
+            AlertDialog popup = new AlertDialog.Builder(this).setTitle("Link this Google TV")
+                    .setMessage("On the PHONE: PatTube → Sync → Link Google TV\n\nEnter code: " + code +
+                            "\n\nWaiting for your phone… (expires in 5 minutes)")
+                    .setNegativeButton("Cancel", (dialog, which) -> open[0] = false)
+                    .create();
+            popup.setOnDismissListener(dialog -> open[0] = false);
+            popup.show();
+            Runnable poll = new Runnable() {
+                @Override public void run() {
+                    if (!open[0] || isFinishing()) return;
+                    sync.pairingStatus(status -> {
+                        if (!open[0]) return;
+                        if (status.ok() && sync.paired()) {
+                            open[0] = false;
+                            popup.dismiss();
+                            toast("TV connected and synchronized");
+                            loadFeed();
+                        } else if (status.code == 410) {
+                            open[0] = false;
+                            popup.dismiss();
+                            toast("Code expired. Start pairing again.");
+                        } else ui.postDelayed(this, 3_000);
+                    });
+                }
+            };
+            ui.post(poll);
+        });
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        if (sync != null && cards != null && sync.paired())
+            sync.syncNow(result -> { if (result.ok()) { updateButtons(); refreshSidebar(); } });
+    }
+
+    @Override protected void onDestroy() {
+        generation++;
+        actions.clear();
+        ui.removeCallbacksAndMessages(null);
+        super.onDestroy();
+    }
+
+    private final class CardAdapter extends RecyclerView.Adapter<CardAdapter.Holder> {
+        final class Holder extends RecyclerView.ViewHolder {
+            final ImageView image;
+            final TextView title;
+            final TextView channel;
+            Holder(View view, ImageView image, TextView title, TextView channel) {
+                super(view);
+                this.image = image; this.title = title; this.channel = channel;
+            }
+        }
+        @NonNull @Override public Holder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            LinearLayout card = new LinearLayout(parent.getContext());
+            card.setOrientation(LinearLayout.VERTICAL);
+            card.setPadding(dp(6), dp(6), dp(6), dp(16));
+            card.setFocusable(true);
+            card.setClickable(true);
+            card.setBackgroundColor(PANEL);
+            ImageView image = new TopCropView(parent.getContext());
+            card.addView(image, new LinearLayout.LayoutParams(-1, dp(tv ? 148 : 110)));
+            TextView title = new TextView(parent.getContext());
+            title.setTextColor(WHITE); title.setTextSize(tv ? 17 : 15); title.setMaxLines(2);
+            title.setPadding(dp(5), dp(6), dp(5), dp(1));
+            card.addView(title, new LinearLayout.LayoutParams(-1, -2));
+            TextView channel = new TextView(parent.getContext());
+            channel.setTextColor(Color.LTGRAY); channel.setTextSize(tv ? 14 : 12); channel.setMaxLines(1);
+            channel.setPadding(dp(5), dp(2), dp(5), dp(2));
+            card.addView(channel, new LinearLayout.LayoutParams(-1, -2));
+            return new Holder(card, image, title, channel);
+        }
+        @Override public void onBindViewHolder(@NonNull Holder holder, int index) {
+            Item item = visible.get(index);
+            holder.title.setText(item.title());
+            holder.channel.setText((item.isRumble() ? "Rumble • " : "YouTube • ") + item.channel());
+            Glide.with(holder.image).load(item.thumbnail()).into(holder.image);
+            holder.itemView.setOnClickListener(view -> open(item));
+            holder.itemView.setOnFocusChangeListener((view, focused) -> view.setBackgroundColor(focused ? RED : PANEL));
+            holder.itemView.setOnLongClickListener(view -> {
+                if (item.isRumble()) {
+                    String id = item.rumble.optString("channelUrl", item.rumble.optString("channelId"));
+                    sync.follow(id, item.rumble.optString("channelName", id), !sync.isFollowed(id));
+                    if (sync.paired()) sync.syncNow(null);
+                    refreshSidebar();
+                    toast(sync.isFollowed(id) ? "Following channel" : "Unfollowed channel");
+                    return true;
+                }
+                return false;
+            });
+        }
+        @Override public int getItemCount() { return visible.size(); }
+    }
+}
