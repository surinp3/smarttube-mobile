+    private void updateButtons() {
+        String selected = sync.sourceFilter();
+        for (Button button : new Button[]{ytButton, rumbleButton, bothButton}) {
+            String mode = button == ytButton ? "youtube" : button == rumbleButton ? "rumble" : "both";
+            button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(mode.equals(selected) ? RED : PANEL));
+        }
+    }
+
+    private void refreshSidebar() {
+        if (sidebar == null) return;
+        sidebar.removeAllViews();
+        sidebar.addView(action("My Rumble channels", () -> { subscriptions = true; query = ""; selectedChannel = ""; loadFeed(); }));
+        sidebar.addView(action("+ Follow URL", this::followChannelUrl));
+        JSONArray followed = sync.followedChannels();
+        List<JSONObject> ordered = new ArrayList<>();
+        for (int i = 0; i < followed.length(); i++) {
+            JSONObject channel = followed.optJSONObject(i);
+            if (channel != null) ordered.add(channel);
+        }
+        Collections.sort(ordered, Comparator.comparingInt(a -> a.optInt("order")));
+        for (JSONObject channel : ordered) {
+            String id = channel.optString("id");
+            String label = channel.optString("name", id);
+            Button button = action(label, () -> {
+                selectedChannel = channelUrl(id);
+                query = "";
+                loadFeed();
+            });
+            button.setOnLongClickListener(v -> {
+                sync.moveFollowedChannel(id, -1);
+                sync.syncNow(null);
+                refreshSidebar();
+                return true;
+            });
+            sidebar.addView(button, new LinearLayout.LayoutParams(-1, dp(60)));
+        }
+        // Follow/unfollow/reorder writes the Rumble sidebar to Bunny.
+        // This menu leaves SmartTube's native YouTube sidebar untouched.
+    }
