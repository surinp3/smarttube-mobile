+            FrameLayout thumbnail = new FrameLayout(parent.getContext());
+            thumbnail.setBackground(roundBackground(SURFACE, 10));
+            thumbnail.setClipToOutline(true);
+            ImageView image = new ImageView(parent.getContext());
+            image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            thumbnail.addView(image, new FrameLayout.LayoutParams(-1, -1));
+            TextView duration = text("", 12, PRIMARY);
+            duration.setGravity(Gravity.CENTER);
+            duration.setTypeface(Typeface.DEFAULT_BOLD);
+            duration.setBackground(roundBackground(Color.rgb(15, 15, 15), 5));
+            duration.setPadding(dp(7), dp(3), dp(7), dp(3));
+            FrameLayout.LayoutParams timePosition = new FrameLayout.LayoutParams(-2, -2, Gravity.RIGHT | Gravity.BOTTOM);
+            timePosition.setMargins(dp(8), dp(8), dp(8), dp(8));
+            thumbnail.addView(duration, timePosition);
+            card.addView(thumbnail, new LinearLayout.LayoutParams(-1, thumbnailHeight()));
+            TextView heading = text("", 16, PRIMARY);
+            heading.setTypeface(Typeface.DEFAULT_BOLD);
+            heading.setMaxLines(3);
+            heading.setLineSpacing(dp(2), 1f);
+            heading.setEllipsize(TextUtils.TruncateAt.END);
+            heading.setPadding(dp(3), dp(9), dp(3), dp(2));
+            card.addView(heading, wrapWidth());
+            TextView meta = text("", 13, SECONDARY);
+            meta.setMaxLines(2);
+            meta.setPadding(dp(3), dp(2), dp(3), dp(2));
