+    private void startAccountSignIn() {
+        signInActions.clear();
+        final String[] activationCode = {""};
+        AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle("Connect your YouTube account")
+                .setMessage("Requesting a secure YouTube activation code…")
+                .setNegativeButton("Cancel", (d, which) -> signInActions.clear())
+                .setNeutralButton("Copy code", null)
+                .setPositiveButton("Open YouTube", (d, which) -> {
+                    copyActivationCode(activationCode[0]);
+                    openUrl("https://yt.be/activate");
+                })
+                .create();
+        dialog.show();
+        dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
+                .setOnClickListener(v -> copyActivationCode(activationCode[0]));
+        signInActions.add(signInService().signInObserve().subscribe(code ->
+                runOnUiThread(() -> {
+                    activationCode[0] = code;
+                    if (dialog.isShowing()) {
+                        dialog.setMessage("Open yt.be/activate and enter this code:\n\n" + code +
+                                "\n\nOnce approved, return to SmartTube Mobile.");
+                    }
+                }), error -> runOnUiThread(() -> {
+                    dialog.dismiss();
+                    if (isDnsFailure(error)) {
+                        new AlertDialog.Builder(this)
+                                .setTitle("Can't reach YouTube")
+                                .setMessage("The code may have been accepted at yt.be, but SmartTube Mobile " +
+                                        "couldn't resolve www.youtube.com afterward. Check Wi-Fi/mobile data " +
+                                        "and your phone's Private DNS (AdGuard/NextDNS). Try Prefer IPv4 " +
+                                        "in the app's DNS settings if the connection still fails.")
+                                .setNegativeButton("Close", null)
+                                .setNeutralButton("New code", (d, which) -> startAccountSignIn())
+                                .setPositiveButton("DNS options", (d, which) -> chooseDnsMode())
+                                .show();
+                    } else {
+                        new AlertDialog.Builder(this).setTitle("Sign-in failed")
+                                .setMessage(error.getMessage() != null ? error.getMessage() : "Please try again.")
+                                .setPositiveButton("OK", null).show();
+                    }
+                }), () -> runOnUiThread(() -> {
+                    dialog.dismiss();
+                    lastAccountId = accountId();
+                    Toast.makeText(this, "YouTube account connected", Toast.LENGTH_SHORT).show();
+                    loadCuratedFeed(false);
+                })));
+    }
+
+    private boolean isDnsFailure(Throwable error) {
+        for (Throwable cause = error; cause != null; cause = cause.getCause()) {
+            if (cause instanceof UnknownHostException ||
+                    (cause.getMessage() != null &&
+                            cause.getMessage().contains("Unable to resolve host"))) {
+                return true;
+            }
+        }
+        return false;
+    }
