+    /** Load YouTube's actual Home recommendations once, preserving their order. */
+    private void loadYouTubeHome() {
+        final boolean hideShorts = hideShortsOnHome();
+        curatedActions.add(Observable.fromCallable(() ->
+                        YouTubeServiceManager.instance().getContentService().getHome())
+                .subscribeOn(io.reactivex.schedulers.Schedulers.io())
+                .subscribe(groups -> {
+                    List<Video> picked = new ArrayList<>();
+                    Set<String> seen = new HashSet<>();
+                    MediaGroup nextPage = null;
+                    if (groups != null) {
+                        for (MediaGroup group : groups) {
+                            if (group == null) continue;
+                            if (nextPage == null && group.getNextPageKey() != null) nextPage = group;
+                            if (hideShorts && group.getType() == MediaGroup.TYPE_SHORTS) continue;
+                            VideoGroup videos = VideoGroup.from(group);
+                            if (videos != null && videos.getVideos() != null) {
+                                for (Video video : videos.getVideos()) {
+                                    if (video != null && (!hideShorts || !video.isShorts) &&
+                                            !TextUtils.isEmpty(video.videoId) && seen.add(video.videoId)) {
+                                        picked.add(video);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    final MediaGroup continuation = nextPage;
+                    runOnUiThread(() -> {
+                        if (activeTab != Tab.HOME) return;
+                        progress.setVisibility(View.GONE);
+                        if (picked.isEmpty()) {
+                            showHomeUnavailable();
+                        } else {
+                            accountPage = continuation;
+                            emptyPanel.setVisibility(View.GONE);
+                            adapter.setHomeVideos(picked);
+                        }
+                    });
+                }, error -> runOnUiThread(() -> {
+                    if (activeTab != Tab.HOME) return;
+                    progress.setVisibility(View.GONE);
+                    showHomeUnavailable();
+                })));
+    }
+
+    private void showHomeUnavailable() {
+        if (!signInService().isSigned())
+            showEmpty("Connect your YouTube account to see personalized Home recommendations.", true);
+        else
+            showEmpty("YouTube recommendations couldn't be loaded. Tap Refresh to try again.", false);
+    }
+
+    private void loadAccountSubscriptions() {
+        curatedActions.add(YouTubeServiceManager.instance().getContentService()
+                .getSubscriptionsObserve()
+                .subscribe(group -> {
+                    VideoGroup videos = VideoGroup.from(group);
+                    runOnUiThread(() -> {
+                        if (activeTab != Tab.SUBSCRIPTIONS) return;
+                        accountPage = group;
+                        if (videos != null && videos.getVideos() != null && !videos.getVideos().isEmpty()) {
+                            emptyPanel.setVisibility(View.GONE);
+                            adapter.appendCurated(videos, Integer.MAX_VALUE, true, true, false);
+                        } else {
+                            showEmpty("No subscription videos found. Pull up Settings to check your account.", false);
+                        }
+                        progress.setVisibility(View.GONE);
+                    });
+                }, error -> runOnUiThread(() -> {
+                    progress.setVisibility(View.GONE);
+                    if (activeTab == Tab.SUBSCRIPTIONS)
+                        showEmpty("Couldn't load subscriptions. Check your connection and YouTube account.", false);
+                })));
+    }
