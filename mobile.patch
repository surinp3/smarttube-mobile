+    private void chooseDnsMode() {
+        final int[] modes = {GlobalPreferences.DNS_TYPE_SYSTEM,
+                GlobalPreferences.DNS_TYPE_IPV4, GlobalPreferences.DNS_TYPE_GOOGLE};
+        String[] labels = {"Android system DNS (uses Private DNS)",
+                "Prefer IPv4 (uses phone DNS)",
+                "Google Public DNS (may bypass Private DNS)"};
+        int checked = 0;
+        int current = GlobalPreferences.instance(this).getPreferredDnsType();
+        for (int i = 0; i < modes.length; i++) {
+            if (modes[i] == current) checked = i;
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("YouTube DNS")
+                .setMessage("SmartTube's developer recommends trying IPv4 when YouTube host lookup fails. " +
+                        "Google DNS can bypass phone-level DNS filtering, so choose it only if you want that.")
+                .setSingleChoiceItems(labels, checked, (dialog, selected) -> {
+                    dialog.dismiss();
+                    if (modes[selected] == current) return;
+                    new AlertDialog.Builder(this)
+                            .setTitle("Restart SmartTube Mobile?")
+                            .setMessage("The new DNS mode requires the app to restart.")
+                            .setNegativeButton("Cancel", null)
+                            .setPositiveButton("Change & restart", (confirm, which) -> {
+                                GlobalPreferences.instance(this).setPreferredDnsType(modes[selected]);
+                                Utils.restartTheApp(this);
