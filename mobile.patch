+    private void checkForUpdates() {
+        Toast.makeText(this, "Checking for updates…", Toast.LENGTH_SHORT).show();
+        new Thread(() -> {
+            HttpURLConnection connection = null;
+            try {
+                connection = (HttpURLConnection) new URL(RELEASES_API).openConnection();
+                connection.setConnectTimeout(9000);
+                connection.setReadTimeout(9000);
+                connection.setRequestProperty("Accept", "application/vnd.github+json");
+                connection.setRequestProperty("User-Agent", "SmartTube-Mobile/" + MOBILE_VERSION);
+                int status = connection.getResponseCode();
+                if (status == 404) {
+                    runOnUiThread(() -> updateMessage("No published mobile releases yet",
+                            "The in-app checker is ready; builds must be published as GitHub releases.", RELEASES_URL));
+                    return;
+                }
+                if (status != 200) throw new IllegalStateException("GitHub returned HTTP " + status);
+                StringBuilder body = new StringBuilder();
+                try (BufferedReader reader = new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
+                    String line;
+                    while ((line = reader.readLine()) != null && body.length() < 500_000) body.append(line);
+                }
+                JSONObject release = new JSONObject(body.toString());
+                String tag = release.optString("tag_name", "");
+                java.util.regex.Matcher matcher = java.util.regex.Pattern
+                        .compile("(?i)(?:mobile[-_ ]?)?v?(\\d+)").matcher(tag);
+                if (!matcher.find()) throw new IllegalStateException("Unrecognized release version: " + tag);
+                int latestVersion = Integer.parseInt(matcher.group(1));
+                JSONArray assets = release.optJSONArray("assets");
+                String downloadUrl = null;
+                if (assets != null) {
+                    for (int i = 0; i < assets.length(); i++) {
+                        JSONObject asset = assets.optJSONObject(i);
+                        if (asset == null) continue;
+                        String name = asset.optString("name").toLowerCase();
+                        if (name.endsWith(".apk") && name.contains("arm64")) {
+                            downloadUrl = asset.optString("browser_download_url");
+                            break;
+                        }
+                    }
+                }
+                String releaseUrl = release.optString("html_url", RELEASES_URL);
+                if (!releaseUrl.startsWith(RELEASES_URL)) releaseUrl = RELEASES_URL;
+                final String trustedUrl = downloadUrl != null && downloadUrl.startsWith(RELEASES_URL + "/download/")
+                        ? downloadUrl : releaseUrl;
+                runOnUiThread(() -> {
+                    if (latestVersion > MOBILE_VERSION) {
+                        updateMessage("SmartTube Mobile v" + latestVersion + " is available",
+                                "Download the new signed APK and open it to update.", trustedUrl);
+                    } else {
+                        updateMessage("You're up to date", "Version " + MOBILE_VERSION + " is the latest published mobile release.", null);
+                    }
+                });
+            } catch (Exception error) {
+                runOnUiThread(() -> updateMessage("Update check failed",
+                        "Couldn't reach GitHub releases. Check your connection and try again.", RELEASES_URL));
+            } finally {
+                if (connection != null) connection.disconnect();
+            }
+        }).start();
+    }
