+        setTab(Tab.SEARCH, "Results");
+        progress.setVisibility(View.VISIBLE);
+        ((InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE))
+                .hideSoftInputFromWindow(searchInput.getWindowToken(), 0);
+        curatedActions.add(YouTubeServiceManager.instance().getContentService()
+                .getSearchObserve(query, SearchOptions.TYPE_VIDEO)
+                .subscribe(groups -> {
+                    for (MediaGroup group : groups) {
+                        VideoGroup videos = VideoGroup.from(group);
+                        if (videos != null && videos.getVideos() != null && !videos.getVideos().isEmpty()) {
+                            runOnUiThread(() -> {
