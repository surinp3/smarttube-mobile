+        List<String> relatedQueries = new ArrayList<>();
+        if (!subscriptionsOnly) {
+            relatedQueries.add("car restoration workshop fabrication");
+            relatedQueries.add("machining engineering maker projects");
+            relatedQueries.add("Thailand Pattaya legal expat news");
+            relatedQueries.add("solar power DIY technology");
