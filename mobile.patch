+    private final class VideoAdapter extends RecyclerView.Adapter<VideoHolder> {
+        private final List<Video> videos = new ArrayList<>();
+        private final List<Video> subscriptionVideos = new ArrayList<>();
+        private final List<Video> recommendedVideos = new ArrayList<>();
+
+        /** One atomic Home update: no subscription insertion or age-based resorting. */
+        void setHomeVideos(List<Video> picks) {
+            videos.clear();
+            subscriptionVideos.clear();
+            recommendedVideos.clear();
+            videos.addAll(picks);
+            notifyDataSetChanged();
+        }
+
+        void appendHomePage(VideoGroup group) {
+            if (group == null || group.getVideos() == null) return;
+            boolean hideShorts = hideShortsOnHome();
+            Set<String> seen = new HashSet<>();
+            for (Video existing : videos) {
+                if (!TextUtils.isEmpty(existing.videoId)) seen.add(existing.videoId);
+            }
+            boolean changed = false;
+            for (Video video : group.getVideos()) {
+                if (video != null && (!hideShorts || !video.isShorts) &&
+                        !TextUtils.isEmpty(video.videoId) && seen.add(video.videoId)) {
+                    videos.add(video);
+                    changed = true;
+                }
+            }
+            if (changed) notifyDataSetChanged();
+        }
+
+        void apply(VideoGroup group) {
+            if (group == null || group.getVideos() == null) return;
+            if (group.getAction() == VideoGroup.ACTION_REPLACE || group.getAction() == VideoGroup.ACTION_SYNC) videos.clear();
+            if (group.getAction() == VideoGroup.ACTION_REMOVE) videos.removeAll(group.getVideos());
+            else if (group.getAction() == VideoGroup.ACTION_PREPEND) videos.addAll(0, group.getVideos());
+            else videos.addAll(group.getVideos());
+            notifyDataSetChanged();
+        }
+
+        void clear() { videos.clear(); subscriptionVideos.clear(); recommendedVideos.clear(); notifyDataSetChanged(); }
+        void appendCurated(VideoGroup group, int limit, boolean subscription, boolean subscriptionsOnly) {
+            appendCurated(group, limit, subscription, subscriptionsOnly, true);
+        }
+        void appendCurated(VideoGroup group, int limit, boolean subscription, boolean subscriptionsOnly, boolean sortByAge) {
+            if (group == null || group.getVideos() == null) return;
+            List<Video> target = subscription ? subscriptionVideos : recommendedVideos;
+            int added = 0;
+            for (Video video : group.getVideos()) {
+                boolean exists = false;
+                for (Video current : target) {
+                    if (video.videoId != null && video.videoId.equals(current.videoId)) { exists = true; break; }
+                }
+                if (!exists) { target.add(video); added++; }
+                if (added >= limit) break;
+            }
+            Comparator<Video> newestFirst = (a, b) -> Long.compare(videoAge(a), videoAge(b));
+            if (sortByAge) Collections.sort(subscriptionVideos, newestFirst);
+            Collections.sort(recommendedVideos, newestFirst);
+            videos.clear();
+            if (subscriptionsOnly) {
+                videos.addAll(subscriptionVideos);
+            } else {
+                int sub = 0, rec = 0;
+                while (sub < subscriptionVideos.size() || rec < recommendedVideos.size()) {
+                    for (int i = 0; i < 3 && sub < subscriptionVideos.size(); i++) videos.add(subscriptionVideos.get(sub++));
+                    if (rec < recommendedVideos.size()) videos.add(recommendedVideos.get(rec++));
+                }
+            }
+            notifyDataSetChanged();
+        }
+        long videoAge(Video video) {
+            String text = String.valueOf(video.secondTitle).toLowerCase();
+            if (video.isLive || text.contains("live now")) return 0;
+            java.util.regex.Matcher matcher = java.util.regex.Pattern.compile("(\\d+)\\s*(second|minute|hour|day|week|month|year)").matcher(text);
+            if (!matcher.find()) return Long.MAX_VALUE - video.timestamp;
+            long value = Long.parseLong(matcher.group(1));
+            String unit = matcher.group(2);
+            if (unit.startsWith("minute")) value *= 60;
+            else if (unit.startsWith("hour")) value *= 3_600;
+            else if (unit.startsWith("day")) value *= 86_400;
+            else if (unit.startsWith("week")) value *= 604_800;
+            else if (unit.startsWith("month")) value *= 2_592_000;
+            else if (unit.startsWith("year")) value *= 31_536_000;
+            return value;
+        }
+        int indexOf(Video item) { return videos.indexOf(item); }
+
+        @NonNull @Override
+        public VideoHolder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            LinearLayout card = new LinearLayout(parent.getContext());
+            card.setOrientation(LinearLayout.VERTICAL);
+            card.setPadding(dp(5), dp(5), dp(5), dp(15));
+            FrameLayout thumbnail = new FrameLayout(parent.getContext());
+            thumbnail.setBackground(roundBackground(SURFACE, 10));
+            thumbnail.setClipToOutline(true);
+            ImageView image = new TopCropImageView(parent.getContext());
+            thumbnail.addView(image, new FrameLayout.LayoutParams(-1, -1));
+            TextView duration = text("", 12, PRIMARY);
+            duration.setGravity(Gravity.CENTER);
+            duration.setTypeface(Typeface.DEFAULT_BOLD);
+            duration.setBackground(roundBackground(Color.rgb(15, 15, 15), 5));
+            duration.setPadding(dp(7), dp(3), dp(7), dp(3));
+            FrameLayout.LayoutParams timePosition = new FrameLayout.LayoutParams(-2, -2, Gravity.RIGHT | Gravity.BOTTOM);
+            timePosition.setMargins(dp(8), dp(8), dp(8), dp(8));
+            thumbnail.addView(duration, timePosition);
+            // SmartTube already parses YouTube's cross-device
+            // thumbnailOverlayResumePlaybackRenderer.percentDurationWatched.
+            // Show the same red watched-progress line used on YouTube.
+            View watchedTrack = new View(parent.getContext());
+            watchedTrack.setBackgroundColor(Color.argb(210, 48, 48, 48));
+            thumbnail.addView(watchedTrack, new FrameLayout.LayoutParams(-1, dp(4), Gravity.BOTTOM));
+            View watchedFill = new View(parent.getContext());
+            watchedFill.setBackgroundColor(ACCENT);
+            watchedFill.setPivotX(0f);
+            thumbnail.addView(watchedFill, new FrameLayout.LayoutParams(-1, dp(4), Gravity.BOTTOM));
+            card.addView(thumbnail, new LinearLayout.LayoutParams(-1, thumbnailHeight()));
+            TextView heading = text("", 16, PRIMARY);
+            heading.setTypeface(Typeface.DEFAULT_BOLD);
+            heading.setMaxLines(3);
+            heading.setLineSpacing(dp(2), 1f);
+            heading.setEllipsize(TextUtils.TruncateAt.END);
+            heading.setPadding(dp(3), dp(9), dp(3), dp(2));
+            card.addView(heading, wrapWidth());
+            TextView meta = text("", 13, SECONDARY);
+            meta.setMaxLines(2);
+            meta.setPadding(dp(3), dp(2), dp(3), dp(2));
+            meta.setEllipsize(TextUtils.TruncateAt.END);
