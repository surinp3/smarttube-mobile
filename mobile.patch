+    private void loadNextAccountPage() {
+        if (loadingNextPage || accountPage == null || accountPage.getNextPageKey() == null ||
+                !signInService().isSigned() ||
+                (activeTab != Tab.HOME && activeTab != Tab.SUBSCRIPTIONS && activeTab != Tab.HISTORY)) return;
+        loadingNextPage = true;
+        final MediaGroup previous = accountPage;
+        final Tab requestedTab = activeTab;
+        curatedActions.add(YouTubeServiceManager.instance().getContentService()
+                .continueGroupObserve(previous)
+                .subscribe(next -> runOnUiThread(() -> {
+                    loadingNextPage = false;
+                    if (requestedTab != activeTab || next == null) return;
+                    if (TextUtils.equals(next.getNextPageKey(), previous.getNextPageKey())) {
+                        accountPage = null; // Stop when YouTube repeats a continuation token.
+                    } else {
+                        accountPage = next;
+                    }
+                    VideoGroup additional = VideoGroup.from(next);
+                    if (additional != null && additional.getVideos() != null && !additional.getVideos().isEmpty()) {
+                        if (activeTab == Tab.HISTORY) adapter.apply(additional);
+                        else if (activeTab == Tab.HOME) {
+                            if (!hideShortsOnHome() || next.getType() != MediaGroup.TYPE_SHORTS)
+                                adapter.appendHomePage(additional);
+                        }
+                        else adapter.appendCurated(additional, Integer.MAX_VALUE, true, true, false);
+                    }
+                }), error -> runOnUiThread(() -> {
+                    loadingNextPage = false;
+                    accountPage = null;
+                })));
+    }
