+    private final class VideoAdapter extends RecyclerView.Adapter<VideoHolder> {
+        private final List<Video> videos = new ArrayList<>();
+        private final List<Video> subscriptionVideos = new ArrayList<>();
+        private final List<Video> recommendedVideos = new ArrayList<>();
+
+        void apply(VideoGroup group) {
+            if (group == null || group.getVideos() == null) return;
+            if (group.getAction() == VideoGroup.ACTION_REPLACE || group.getAction() == VideoGroup.ACTION_SYNC) videos.clear();
+            if (group.getAction() == VideoGroup.ACTION_REMOVE) videos.removeAll(group.getVideos());
+            else if (group.getAction() == VideoGroup.ACTION_PREPEND) videos.addAll(0, group.getVideos());
+            else videos.addAll(group.getVideos());
+            notifyDataSetChanged();
+        }
+
+        void clear() { videos.clear(); subscriptionVideos.clear(); recommendedVideos.clear(); notifyDataSetChanged(); }
+        void appendCurated(VideoGroup group, int limit, boolean subscription, boolean subscriptionsOnly) {
+            appendCurated(group, limit, subscription, subscriptionsOnly, true);
+        }
+        void appendCurated(VideoGroup group, int limit, boolean subscription, boolean subscriptionsOnly, boolean sortByAge) {
+            if (group == null || group.getVideos() == null) return;
+            List<Video> target = subscription ? subscriptionVideos : recommendedVideos;
+            int added = 0;
+            for (Video video : group.getVideos()) {
+                boolean exists = false;
+                for (Video current : target) {
+                    if (video.videoId != null && video.videoId.equals(current.videoId)) { exists = true; break; }
+                }
+                if (!exists) { target.add(video); added++; }
+                if (added >= limit) break;
+            }
+            Comparator<Video> newestFirst = (a, b) -> Long.compare(videoAge(a), videoAge(b));
+            if (sortByAge) Collections.sort(subscriptionVideos, newestFirst);
+            Collections.sort(recommendedVideos, newestFirst);
+            videos.clear();
+            if (subscriptionsOnly) {
+                videos.addAll(subscriptionVideos);
+            } else {
+                int sub = 0, rec = 0;
+                while (sub < subscriptionVideos.size() || rec < recommendedVideos.size()) {
+                    for (int i = 0; i < 3 && sub < subscriptionVideos.size(); i++) videos.add(subscriptionVideos.get(sub++));
+                    if (rec < recommendedVideos.size()) videos.add(recommendedVideos.get(rec++));
+                }
+            }
+            notifyDataSetChanged();
+        }
+        long videoAge(Video video) {
+            String text = String.valueOf(video.secondTitle).toLowerCase();
+            if (video.isLive || text.contains("live now")) return 0;
+            java.util.regex.Matcher matcher = java.util.regex.Pattern.compile("(\\d+)\\s*(second|minute|hour|day|week|month|year)").matcher(text);
+            if (!matcher.find()) return Long.MAX_VALUE - video.timestamp;
+            long value = Long.parseLong(matcher.group(1));
+            String unit = matcher.group(2);
+            if (unit.startsWith("minute")) value *= 60;
+            else if (unit.startsWith("hour")) value *= 3_600;
+            else if (unit.startsWith("day")) value *= 86_400;
+            else if (unit.startsWith("week")) value *= 604_800;
+            else if (unit.startsWith("month")) value *= 2_592_000;
+            else if (unit.startsWith("year")) value *= 31_536_000;
+            return value;
+        }
+        int indexOf(Video item) { return videos.indexOf(item); }
+
+        @NonNull @Override
