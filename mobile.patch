+package com.liskovsoft.smartyoutubetv2.mobile.ui;
+
+import android.content.res.Configuration;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.HorizontalScrollView;
+import android.widget.ImageButton;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.GridLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.bumptech.glide.Glide;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.BrowseSection;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.SettingsGroup;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+import com.liskovsoft.smartyoutubetv2.common.app.models.errors.ErrorFragmentData;
+import com.liskovsoft.smartyoutubetv2.common.app.presenters.BrowsePresenter;
+import com.liskovsoft.smartyoutubetv2.common.app.presenters.SearchPresenter;
+import com.liskovsoft.smartyoutubetv2.common.app.presenters.settings.AccountSettingsPresenter;
+import com.liskovsoft.smartyoutubetv2.common.app.views.BrowseView;
+import com.liskovsoft.smartyoutubetv2.common.misc.MotherActivity;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Touch-first phone shell backed by SmartTube's existing BrowsePresenter. */
+public class MobileBrowseActivity extends MotherActivity implements BrowseView {
+    private static final int BACKGROUND = Color.rgb(15, 15, 15);
+    private static final int SURFACE = Color.rgb(31, 31, 31);
+    private static final int PRIMARY = Color.WHITE;
+    private static final int SECONDARY = Color.rgb(170, 170, 170);
+    private static final int ACCENT = Color.rgb(255, 35, 35);
+
+    private final Map<Integer, BrowseSection> sections = new LinkedHashMap<>();
+    private final List<Button> sectionButtons = new ArrayList<>();
+    private BrowsePresenter presenter;
+    private LinearLayout sectionBar;
+    private RecyclerView content;
+    private GridLayoutManager layoutManager;
+    private VideoAdapter adapter;
+    private ProgressBar progress;
+    private TextView title;
+    private int selectedSection = -1;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        buildUi();
+        presenter = BrowsePresenter.instance(this);
+        presenter.setView(this);
+        presenter.onViewInitialized();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (presenter != null) {
+            presenter.setView(this);
+            presenter.onViewResumed();
+        }
+    }
+
+    @Override
+    protected void onPause() {
+        if (presenter != null) presenter.onViewPaused();
+        super.onPause();
+    }
+
+    @Override
+    public void onConfigurationChanged(@NonNull Configuration config) {
+        super.onConfigurationChanged(config);
+        layoutManager.setSpanCount(columnCount());
+    }
+
+    private void buildUi() {
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(BACKGROUND);
+
+        LinearLayout page = new LinearLayout(this);
+        page.setOrientation(LinearLayout.VERTICAL);
+        root.addView(page, match());
+
+        LinearLayout toolbar = new LinearLayout(this);
+        toolbar.setGravity(Gravity.CENTER_VERTICAL);
+        toolbar.setPadding(dp(16), dp(8), dp(8), dp(6));
+        title = text("SmartTube", 22, PRIMARY);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        toolbar.addView(title, new LinearLayout.LayoutParams(0, dp(52), 1));
+
+        ImageButton search = new ImageButton(this);
+        search.setImageResource(android.R.drawable.ic_menu_search);
+        search.setColorFilter(PRIMARY);
+        search.setBackgroundColor(Color.TRANSPARENT);
+        search.setContentDescription("Search");
+        search.setOnClickListener(v -> SearchPresenter.instance(this).startSearch(null));
+        toolbar.addView(search, new LinearLayout.LayoutParams(dp(52), dp(52)));
+
+        ImageButton account = new ImageButton(this);
+        account.setImageResource(R.drawable.ic_user);
+        account.setColorFilter(PRIMARY);
+        account.setBackgroundColor(Color.TRANSPARENT);
+        account.setContentDescription("Account and sign in");
+        account.setOnClickListener(v -> AccountSettingsPresenter.instance(this).show());
+        toolbar.addView(account, new LinearLayout.LayoutParams(dp(52), dp(52)));
+        page.addView(toolbar, wrapWidth());
+
+        HorizontalScrollView scroller = new HorizontalScrollView(this);
+        scroller.setHorizontalScrollBarEnabled(false);
+        sectionBar = new LinearLayout(this);
+        sectionBar.setOrientation(LinearLayout.HORIZONTAL);
+        sectionBar.setPadding(dp(10), 0, dp(10), dp(8));
+        scroller.addView(sectionBar, wrap());
+        page.addView(scroller, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(52)));
+
+        content = new RecyclerView(this);
+        content.setClipToPadding(false);
+        content.setPadding(dp(10), dp(4), dp(10), dp(90));
+        layoutManager = new GridLayoutManager(this, columnCount());
+        content.setLayoutManager(layoutManager);
+        adapter = new VideoAdapter();
+        content.setAdapter(adapter);
+        page.addView(content, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));
+
+        progress = new ProgressBar(this);
+        FrameLayout.LayoutParams progressParams = new FrameLayout.LayoutParams(dp(48), dp(48), Gravity.CENTER);
+        root.addView(progress, progressParams);
+        progress.setVisibility(View.GONE);
+        setContentView(root);
+    }
+
+    private int columnCount() {
+        return getResources().getConfiguration().orientation == Configuration.ORIENTATION_LANDSCAPE ? 2 : 1;
+    }
+
+    @Override
+    public void addSection(int index, BrowseSection section) {
+        sections.put(section.getId(), section);
+        rebuildSections();
+    }
+
+    @Override
+    public void removeSection(BrowseSection section) {
+        sections.remove(section.getId());
+        rebuildSections();
+    }
+
+    @Override
+    public void removeAllSections() {
+        sections.clear();
+        rebuildSections();
+    }
+
+    private void rebuildSections() {
+        runOnUiThread(() -> {
+            sectionBar.removeAllViews();
+            sectionButtons.clear();
+            for (BrowseSection section : sections.values()) {
+                Button button = new Button(this);
+                button.setText(section.getTitle());
+                button.setTextSize(14);
+                button.setAllCaps(false);
+                button.setTextColor(PRIMARY);
+                button.setBackgroundColor(section.getId() == selectedSection ? ACCENT : SURFACE);
+                button.setOnClickListener(v -> selectSectionById(section.getId()));
+                LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT, dp(44));
+                params.setMargins(dp(4), 0, dp(4), 0);
+                sectionBar.addView(button, params);
+                sectionButtons.add(button);
+            }
+        });
+    }
+
+    private void selectSectionById(int id) {
+        int index = 0;
+        for (Integer sectionId : sections.keySet()) {
+            if (sectionId == id) {
+                selectSection(index, true);
+                return;
+            }
+            index++;
+        }
+    }
+
+    @Override
+    public void selectSection(int index, boolean focusOnContent) {
+        if (index < 0 || index >= sections.size()) return;
+        BrowseSection section = new ArrayList<>(sections.values()).get(index);
+        selectedSection = section.getId();
+        title.setText(section.getTitle());
+        adapter.clear();
+        rebuildSections();
+        presenter.onSectionFocused(section.getId());
+        if (focusOnContent) content.requestFocus();
+    }
+
+    @Override
+    public void updateSection(VideoGroup group) {
+        runOnUiThread(() -> adapter.apply(group));
+    }
+
+    @Override
+    public void updateSection(SettingsGroup group) {
+        // Settings continue to use SmartTube's existing dialog UI in milestone one.
+    }
+
+    @Override
+    public void clearSection(BrowseSection section) {
+        if (section != null && section.getId() == selectedSection) adapter.clear();
+    }
+
+    @Override
+    public void selectSectionItem(int index) {
+        if (index >= 0 && index < adapter.getItemCount()) content.scrollToPosition(index);
+    }
+
+    @Override
+    public void selectSectionItem(Video item) {
+        int index = adapter.indexOf(item);
+        if (index >= 0) content.scrollToPosition(index);
+    }
+
+    @Override
+    public void showError(ErrorFragmentData data) {
+        Toast.makeText(this, data != null ? data.getMessage() : "Unable to load this page", Toast.LENGTH_LONG).show();
+    }
+
+    @Override
+    public void showProgressBar(boolean show) {
+        runOnUiThread(() -> progress.setVisibility(show ? View.VISIBLE : View.GONE));
+    }
+
+    @Override public boolean isProgressBarShowing() { return progress.getVisibility() == View.VISIBLE; }
+    @Override public void focusOnContent() { content.requestFocus(); }
+    @Override public boolean isEmpty() { return adapter.getItemCount() == 0; }
+    @Override public void updateBadge() { }
+
+    private final class VideoAdapter extends RecyclerView.Adapter<VideoHolder> {
+        private final List<Video> videos = new ArrayList<>();
+
+        void apply(VideoGroup group) {
+            if (group == null || group.getVideos() == null) return;
+            if (group.getAction() == VideoGroup.ACTION_REPLACE || group.getAction() == VideoGroup.ACTION_SYNC) videos.clear();
+            if (group.getAction() == VideoGroup.ACTION_REMOVE) videos.removeAll(group.getVideos());
+            else if (group.getAction() == VideoGroup.ACTION_PREPEND) videos.addAll(0, group.getVideos());
+            else videos.addAll(group.getVideos());
+            notifyDataSetChanged();
+        }
+
+        void clear() { videos.clear(); notifyDataSetChanged(); }
+        int indexOf(Video item) { return videos.indexOf(item); }
+
+        @NonNull @Override
+        public VideoHolder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            LinearLayout card = new LinearLayout(parent.getContext());
+            card.setOrientation(LinearLayout.VERTICAL);
+            card.setPadding(dp(6), dp(6), dp(6), dp(12));
+            ImageView image = new ImageView(parent.getContext());
+            image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            card.addView(image, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(205)));
+            TextView heading = text("", 16, PRIMARY);
+            heading.setTypeface(Typeface.DEFAULT_BOLD);
+            heading.setMaxLines(2);
+            heading.setEllipsize(TextUtils.TruncateAt.END);
+            card.addView(heading, wrapWidth());
+            TextView meta = text("", 13, SECONDARY);
+            meta.setMaxLines(1);
+            meta.setEllipsize(TextUtils.TruncateAt.END);
+            card.addView(meta, wrapWidth());
+            return new VideoHolder(card, image, heading, meta);
+        }
+
+        @Override public void onBindViewHolder(@NonNull VideoHolder holder, int position) { holder.bind(videos.get(position)); }
+        @Override public int getItemCount() { return videos.size(); }
+    }
+
+    private final class VideoHolder extends RecyclerView.ViewHolder {
+        private final ImageView image;
+        private final TextView heading;
+        private final TextView meta;
+        VideoHolder(View item, ImageView image, TextView heading, TextView meta) {
+            super(item); this.image = image; this.heading = heading; this.meta = meta;
+        }
+        void bind(Video video) {
+            heading.setText(video.title);
+            meta.setText(video.secondTitle != null ? video.secondTitle : video.author);
+            Glide.with(image).load(video.cardImageUrl).placeholder(R.drawable.movie).into(image);
+            itemView.setOnClickListener(v -> presenter.onVideoItemClicked(video));
+            itemView.setOnLongClickListener(v -> { presenter.onVideoItemLongClicked(video); return true; });
+        }
+    }
+
+    private TextView text(String value, int sp, int color) {
+        TextView view = new TextView(this);
+        view.setText(value); view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp); view.setTextColor(color);
+        view.setPadding(dp(6), dp(6), dp(6), dp(2));
+        return view;
+    }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+    private static ViewGroup.LayoutParams match() { return new ViewGroup.LayoutParams(-1, -1); }
+    private static ViewGroup.LayoutParams wrap() { return new ViewGroup.LayoutParams(-2, -2); }
+    private static LinearLayout.LayoutParams wrapWidth() { return new LinearLayout.LayoutParams(-1, -2); }
+}
