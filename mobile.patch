+package com.google.android.exoplayer2.source.sabr.parser;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+
+import com.google.android.exoplayer2.source.sabr.parser.exceptions.SabrPoTokenError;
+import com.google.android.exoplayer2.source.sabr.parser.parts.PoTokenStatusSabrPart.PoTokenStatus;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.StreamProtectionStatus;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.StreamProtectionStatus.Status;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.StreamerContext.ClientInfo;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+@RunWith(AndroidJUnit4.class)
+@Config(sdk = 28)
+public class SabrProtectionStatusTest {
+    @Test
+    public void pendingThenOkContinuesWithToken() {
+        SabrProcessor processor = createProcessor("token", 0);
+        assertStatus(processor, Status.ATTESTATION_PENDING, PoTokenStatus.PENDING);
+        assertStatus(processor, Status.OK, PoTokenStatus.OK);
+    }
+
+    @Test
+    public void pendingThenOkContinuesWithoutToken() {
+        SabrProcessor processor = createProcessor(null, 0);
+        assertStatus(processor, Status.ATTESTATION_PENDING, PoTokenStatus.PENDING_MISSING);
+        assertStatus(processor, Status.OK, PoTokenStatus.NOT_REQUIRED);
+    }
+
+    @Test
+    public void repeatedFailurePropagatesForClientRecovery() {
+        SabrProcessor processor = createProcessor("token", 0);
+        assertStatus(processor, Status.ATTESTATION_REQUIRED, PoTokenStatus.INVALID);
+        assertRejected(processor, Status.ATTESTATION_REQUIRED);
+    }
+
+    @Test
+    public void resumedPlaybackHasSameBoundedRecovery() {
+        SabrProcessor processor = createProcessor(null, 90_000);
+        assertStatus(processor, Status.ATTESTATION_REQUIRED, PoTokenStatus.MISSING);
+        assertRejected(processor, Status.ATTESTATION_PENDING);
+    }
+
+    @Test
+    public void successfulAttestationResetsConsecutiveFailureCount() {
+        SabrProcessor processor = createProcessor("token", 0);
+        assertStatus(processor, Status.ATTESTATION_PENDING, PoTokenStatus.PENDING);
+        assertStatus(processor, Status.OK, PoTokenStatus.OK);
+        assertStatus(processor, Status.ATTESTATION_PENDING, PoTokenStatus.PENDING);
+        assertRejected(processor, Status.ATTESTATION_PENDING);
+    }
+
+    @Test
+    public void failureCountBelongsToEachStream() {
+        SabrProcessor first = createProcessor("token", 0);
+        assertStatus(first, Status.ATTESTATION_PENDING, PoTokenStatus.PENDING);
+        assertRejected(first, Status.ATTESTATION_PENDING);
+        assertStatus(createProcessor("token", 0), Status.ATTESTATION_PENDING, PoTokenStatus.PENDING);
+    }
+
+    private static SabrProcessor createProcessor(String token, long positionMs) {
+        return new SabrProcessor("", ClientInfo.getDefaultInstance(), 5, 100,
+                positionMs, token, false, "test-video", 180_000);
+    }
+
+    private static StreamProtectionStatus protection(Status status) {
+        return StreamProtectionStatus.newBuilder().setStatus(status).build();
+    }
+
+    private static void assertStatus(SabrProcessor processor, Status status, PoTokenStatus expected) {
+        assertEquals(expected, processor.processStreamProtectionStatus(protection(status)).sabrPart.status);
+    }
+
+    private static void assertRejected(SabrProcessor processor, Status status) {
+        try {
+            processor.processStreamProtectionStatus(protection(status));
+            fail("Repeated attestation failure must reach client recovery");
+        } catch (SabrPoTokenError expected) {
+            // Expected: do not leave the player buffering forever on a rejected token.
+        }
+    }
+}
