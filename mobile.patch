+        loadingNextPage = false;
+        adapter.clear();
+        setTab(Tab.HISTORY, "History");
+        if (!signInService().isSigned()) {
+            showEmpty("Connect your YouTube account to load your watch history.", true);
+            return;
+        }
+        progress.setVisibility(View.VISIBLE);
+        curatedActions.add(YouTubeServiceManager.instance().getContentService().getHistoryObserve()
+                .subscribe(group -> runOnUiThread(() -> {
+                    if (activeTab != Tab.HISTORY) return;
+                    accountPage = group;
+                    VideoGroup videos = VideoGroup.from(group);
+                    if (videos != null && videos.getVideos() != null && !videos.getVideos().isEmpty()) {
+                        adapter.apply(videos);
