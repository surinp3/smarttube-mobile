+            return new VideoHolder(card, thumbnail, image, duration, watchedTrack, watchedFill, heading, meta);
+        }
+
+        @Override public void onBindViewHolder(@NonNull VideoHolder holder, int position) { holder.bind(videos.get(position)); }
+        @Override public int getItemCount() { return videos.size(); }
+    }
+
+    private final class VideoHolder extends RecyclerView.ViewHolder {
+        private final FrameLayout thumbnail;
+        private final ImageView image;
+        private final TextView duration;
+        private final View watchedTrack;
+        private final View watchedFill;
+        private final TextView heading;
+        private final TextView meta;
+        VideoHolder(View item, FrameLayout thumbnail, ImageView image, TextView duration,
+                    View watchedTrack, View watchedFill, TextView heading, TextView meta) {
+            super(item);
+            this.thumbnail = thumbnail;
+            this.image = image;
+            this.duration = duration;
+            this.watchedTrack = watchedTrack;
+            this.watchedFill = watchedFill;
+            this.heading = heading;
+            this.meta = meta;
+        }
+        void bind(Video video) {
+            ViewGroup.LayoutParams thumbnailLayout = thumbnail.getLayoutParams();
+            thumbnailLayout.height = thumbnailHeight();
+            thumbnail.setLayoutParams(thumbnailLayout);
+            heading.setText(video.title);
+            String detail = video.secondTitle != null ? video.secondTitle.toString() : "";
+            String author = video.getAuthor();
+            if (TextUtils.isEmpty(detail)) {
+                meta.setText(author);
+            } else if (!TextUtils.isEmpty(author) && !detail.contains(author)) {
+                meta.setText(author + "  •  " + detail);
+            } else {
+                meta.setText(detail);
+            }
+            long ms = video.getDurationMs();
+            if (video.isLive) {
+                duration.setText("LIVE");
+                duration.setBackground(roundBackground(ACCENT, 5));
+                duration.setVisibility(View.VISIBLE);
+            } else if (ms > 0) {
+                duration.setText(formatDuration(ms));
+                duration.setBackground(roundBackground(Color.rgb(15, 15, 15), 5));
+                duration.setVisibility(View.VISIBLE);
+            } else {
+                duration.setVisibility(View.GONE);
+            }
+            float watched = video.percentWatched;
+            boolean hasWatchProgress = !video.isLive && !video.isUpcoming &&
+                    !Float.isNaN(watched) && watched > 0f;
+            watchedTrack.setVisibility(hasWatchProgress ? View.VISIBLE : View.GONE);
+            watchedFill.setVisibility(hasWatchProgress ? View.VISIBLE : View.GONE);
+            if (hasWatchProgress) {
+                watchedFill.setScaleX(Math.min(100f, watched) / 100f);
+            }
+            Glide.with(image).load(video.cardImageUrl).placeholder(R.drawable.movie).into(image);
+            itemView.setOnClickListener(v -> presenter.onVideoItemClicked(video));
+            itemView.setOnLongClickListener(v -> { presenter.onVideoItemLongClicked(video); return true; });
+        }
+    }
+
+    /** Fill the card like CENTER_CROP, but keep the top of tall images visible. */
+    private static final class TopCropImageView extends ImageView {
+        private final Matrix topCropMatrix = new Matrix();
+
+        TopCropImageView(Context context) {
+            super(context);
+            setScaleType(ScaleType.MATRIX);
+        }
+
+        @Override
+        public void setImageDrawable(Drawable drawable) {
+            super.setImageDrawable(drawable);
+            if (topCropMatrix != null) updateTopCrop();
+        }
+
+        @Override
+        protected void onSizeChanged(int width, int height, int previousWidth, int previousHeight) {
+            super.onSizeChanged(width, height, previousWidth, previousHeight);
+            updateTopCrop();
+        }
+
+        private void updateTopCrop() {
+            Drawable drawable = getDrawable();
+            if (drawable == null) return;
+            int width = getWidth() - getPaddingLeft() - getPaddingRight();
+            int height = getHeight() - getPaddingTop() - getPaddingBottom();
+            int imageWidth = drawable.getIntrinsicWidth();
+            int imageHeight = drawable.getIntrinsicHeight();
+            if (width <= 0 || height <= 0 || imageWidth <= 0 || imageHeight <= 0) return;
+
+            float scale = Math.max((float) width / imageWidth, (float) height / imageHeight);
+            float centeredX = (width - imageWidth * scale) / 2f;
+            topCropMatrix.reset();
+            topCropMatrix.setScale(scale, scale);
+            topCropMatrix.postTranslate(centeredX, 0f); // Y=0: crop the bottom, not the top.
+            setImageMatrix(topCropMatrix);
+        }
+    }
+
+    private int thumbnailHeight() {
+        int width = getResources().getDisplayMetrics().widthPixels / columnCount() - dp(30);
+        return Math.max(dp(140), Math.round(width * 9f / 16f));
+    }
+
+    private static String formatDuration(long durationMs) {
+        long seconds = durationMs / 1000;
+        long hours = seconds / 3600;
+        long minutes = (seconds % 3600) / 60;
+        long remainder = seconds % 60;
+        if (hours > 0) return String.format(java.util.Locale.US, "%d:%02d:%02d", hours, minutes, remainder);
+        return String.format(java.util.Locale.US, "%d:%02d", minutes, remainder);
+    }
+
+    private TextView text(String value, int sp, int color) {
+        TextView view = new TextView(this);
+        view.setText(value); view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp); view.setTextColor(color);
+        view.setPadding(dp(6), dp(6), dp(6), dp(2));
+        return view;
+    }
+    private void addBottomAction(LinearLayout bar, String label, int iconRes, Runnable action) {
+        Button button = new Button(this);
+        button.setText(label);
+        button.setTextSize(10);
+        button.setTextColor(SECONDARY);
+        button.setAllCaps(false);
+        button.setCompoundDrawablesWithIntrinsicBounds(0, iconRes, 0, 0);
+        button.setCompoundDrawablePadding(dp(5));
+        button.setBackgroundColor(Color.TRANSPARENT);
+        button.setGravity(Gravity.CENTER);
+        button.setPadding(0, dp(5), 0, dp(5));
+        button.setMinHeight(0);
+        button.setMinimumHeight(0);
+        button.setOnClickListener(v -> action.run());
+        navButtons.add(button);
+        bar.addView(button, new LinearLayout.LayoutParams(0, dp(70), 1));
+    }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+    private static ViewGroup.LayoutParams match() { return new ViewGroup.LayoutParams(-1, -1); }
+    private static ViewGroup.LayoutParams wrap() { return new ViewGroup.LayoutParams(-2, -2); }
+    private static LinearLayout.LayoutParams wrapWidth() { return new LinearLayout.LayoutParams(-1, -2); }
+}
