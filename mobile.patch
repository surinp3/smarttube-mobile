+
+    private void loadDirectSubscriptionFeeds(boolean subscriptionsOnly) {
+        curatedActions.add(Observable.fromArray(LOCAL_CHANNEL_HANDLES)
+                .flatMap(handle -> YouTubeServiceManager.instance().getContentService()
+                        .getChannelObserve(handle)
+                        .onErrorResumeNext(Observable.empty()), false, 6)
+                .subscribe(groups -> {
+                    MediaGroup uploads = null;
+                    for (MediaGroup group : groups) {
+                        String groupTitle = group.getTitle() == null ? "" : group.getTitle().toLowerCase();
+                        if ((groupTitle.contains("upload") || groupTitle.equals("videos") || groupTitle.contains("latest"))
+                                && !groupTitle.contains("popular") && !groupTitle.contains("short")) {
+                            uploads = group;
+                            break;
+                        }
+                    }
+                    if (uploads == null) {
+                        for (MediaGroup group : groups) {
+                            if (group.getMediaItems() != null && !group.getMediaItems().isEmpty()) {
+                                VideoGroup candidate = VideoGroup.from(group);
+                                if (candidate != null && candidate.getVideos() != null) {
+                                    for (Video video : candidate.getVideos()) {
+                                        if (video.videoId != null) { uploads = group; break; }
+                                    }
+                                }
+                            }
+                            if (uploads != null) break;
+                        }
+                    }
+                    if (uploads != null) {
+                        VideoGroup videoGroup = VideoGroup.from(uploads);
+                        runOnUiThread(() -> adapter.appendCurated(videoGroup, 3, true, subscriptionsOnly));
+                    }
+                }, error -> runOnUiThread(() -> progress.setVisibility(View.GONE)),
+                        () -> runOnUiThread(() -> progress.setVisibility(View.GONE))));
+    }
+
+    private void loadCuratedQuery(String query, boolean subscription, boolean subscriptionsOnly) {
+            int options = SearchOptions.TYPE_VIDEO | SearchOptions.SORT_BY_UPLOAD_DATE;
+            curatedActions.add(YouTubeServiceManager.instance().getContentService().getSearchObserve(query, options)
+                    .subscribe(groups -> {
+                        for (MediaGroup mediaGroup : groups) {
+                            VideoGroup videoGroup = VideoGroup.from(mediaGroup);
+                            if (videoGroup != null && videoGroup.getVideos() != null && !videoGroup.getVideos().isEmpty()) {
+                                runOnUiThread(() -> adapter.appendCurated(videoGroup, 6, subscription, subscriptionsOnly));
+                                break;
+                            }
+                        }
+                        runOnUiThread(() -> progress.setVisibility(View.GONE));
+                    }, error -> runOnUiThread(() -> progress.setVisibility(View.GONE))));
+    }
