--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/NewsRequestLocale.kt
@@ -0,0 +1,15 @@
+package com.liskovsoft.youtubeapi.common.helpers
+
+import org.json.JSONObject
+
+internal object NewsRequestLocale {
+    fun apply(query: String, english: Boolean): String {
+        val result = JSONObject(query)
+        val client = result.getJSONObject("context").getJSONObject("client")
+        val language = if (english) PreferredNewsPolicy.ENGLISH_LANGUAGE else PreferredNewsPolicy.SWEDISH_LANGUAGE
+        val country = if (english) PreferredNewsPolicy.ENGLISH_COUNTRY else PreferredNewsPolicy.SWEDISH_COUNTRY
+        client.put("hl", language).put("gl", country)
+            .put("acceptLanguage", language).put("acceptRegion", country)
+        return result.toString()
+    }
+}
diff --git a/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/PreferredNewsPolicy.java b/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/PreferredNewsPolicy.java
