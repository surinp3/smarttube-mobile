index 00000000..e9358c0d
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/PreferredNewsPolicy.java
@@ -0,0 +1,70 @@
+package com.liskovsoft.youtubeapi.common.helpers;
+
+import java.text.Normalizer;
+import java.util.Locale;
+
+/** Explicit news preferences, independent of the device or account region. */
+public final class PreferredNewsPolicy {
+    public static final String SWEDISH_LANGUAGE = "sv";
+    public static final String SWEDISH_COUNTRY = "SE";
+    public static final String ENGLISH_LANGUAGE = "en";
+    public static final String ENGLISH_COUNTRY = "GB";
+    public static final String RUMBLE_QUERY = "breaking news";
+
+    private PreferredNewsPolicy() {}
+
+    public static boolean accepts(String title, String author, String row, boolean englishFallback) {
+        if (title == null || title.trim().isEmpty() || hasThai(title) || hasThai(author)) return false;
+        String headline = normalize(title);
+        String publisher = normalize(author);
+        if (englishFallback) {
+            boolean breaking = (" " + headline + " ").contains(" breaking ") || normalize(row).contains("breaking");
+            if (!breaking || !isLatinText(title)) return false;
+            return englishPublisher(publisher) || headline.matches(".*\\b(news|the|after|with|from|report|reports|says|over|as|is|in|on|of)\\b.*");
+        }
+        return swedishPublisher(publisher) || headline.matches(
+                ".*\\b(sverige|sweden|swedish|stockholm|goteborg|malmo|riksdagen|regeringen|nyheter|nyheten)\\b.*");
+    }
+
+    public static boolean isNewsTopic(String topic) {
+        String text = normalize(topic);
+        return text.contains("news") || text.contains("nyheter") || text.contains("nytt");
+    }
+
+    private static boolean swedishPublisher(String value) {
+        return value.equals("svt") || value.startsWith("svt nyheter") || value.startsWith("tv4") ||
+                value.startsWith("nyhetsmorgon") || value.startsWith("sveriges radio") ||
+                value.equals("ekot") || value.startsWith("aftonbladet") || value.startsWith("expressen") ||
+                value.startsWith("dagens nyheter");
+    }
+
+    private static boolean englishPublisher(String value) {
+        return value.equals("bbc news") || value.equals("sky news") || value.equals("reuters") ||
+                value.equals("associated press") || value.equals("ap news") || value.equals("dw news") ||
+                value.equals("france 24 english") || value.equals("al jazeera english") ||
+                value.equals("nbc news") || value.equals("abc news") || value.equals("cbs news");
+    }
+
+    private static boolean hasThai(String value) {
+        if (value == null) return false;
+        for (int i = 0; i < value.length(); i++)
+            if (value.charAt(i) >= '\u0e00' && value.charAt(i) <= '\u0e7f') return true;
+        return false;
+    }
+
+    private static boolean isLatinText(String value) {
+        for (int i = 0; i < value.length(); i++) {
+            char letter = value.charAt(i);
+            if (Character.isLetter(letter) && Character.UnicodeBlock.of(letter) != Character.UnicodeBlock.BASIC_LATIN &&
+                    Character.UnicodeBlock.of(letter) != Character.UnicodeBlock.LATIN_1_SUPPLEMENT &&
+                    Character.UnicodeBlock.of(letter) != Character.UnicodeBlock.LATIN_EXTENDED_A) return false;
+        }
+        return true;
+    }
+
+    private static String normalize(String value) {
+        return value == null ? "" : Normalizer.normalize(value, Normalizer.Form.NFKD)
+                .replaceAll("\\p{M}+", "").toLowerCase(Locale.ROOT)
+                .replaceAll("[^\\p{L}\\p{N}]+", " ").trim();
+    }
+}
