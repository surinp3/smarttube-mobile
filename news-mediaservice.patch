diff --git a/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/PreferredNewsFeed.java b/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/helpers/PreferredNewsFeed.java
