+package com.liskovsoft.youtubeapi.common.helpers;
+
+import com.liskovsoft.mediaserviceinterfaces.data.MediaGroup;
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItem;
+import com.liskovsoft.youtubeapi.service.data.YouTubeMediaGroup;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/** Fill a fresh news selection; a single Swedish result must not suppress every other source. */
+public final class PreferredNewsFeed {
+    // Upstream's sparse filter table returns null for Today|Video|Newest.
+    // This supported Today parameter already includes video type on the wire.
+    public static final int SEARCH_OPTIONS = com.liskovsoft.mediaserviceinterfaces.data.SearchOptions.UPLOAD_DATE_TODAY;
+    public static final int ITEMS_PER_LANGUAGE = 24;
+    public static final int ITEMS_PER_PUBLISHER = 8;
+    public static final long MAX_AGE_MS = 48L * 60 * 60 * 1000;
+    private static final String[] SWEDISH = {"SVT Nyheter", "TV4 Nyheterna", "Aftonbladet nyheter", "Expressen nyheter", "EFN Ekonomikanalen", "Dagens industri"};
+    private static final String[] ENGLISH = {"BBC News breaking", "Sky News breaking", "Reuters breaking news"};
+
+    public interface Source {
+        List<MediaGroup> search(String query, boolean english);
+    }
+
+    private PreferredNewsFeed() {}
+
+    public static List<MediaGroup> load(Source source, long now) {
+        List<MediaGroup> result = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+        for (boolean english : new boolean[] {false, true}) {
+            long deadline = System.nanoTime() + 12_000_000_000L;
+            List<MediaItem> accepted = new ArrayList<>();
+            Map<String, Integer> publishers = new HashMap<>();
+            for (String query : english ? ENGLISH : SWEDISH) {
+                if (accepted.size() >= ITEMS_PER_LANGUAGE || System.nanoTime() >= deadline) break;
+                List<MediaGroup> groups;
+                try { groups = source.search(query, english); }
+                catch (RuntimeException unavailable) { continue; }
+                if (groups == null) continue;
+                for (MediaGroup group : groups) {
+                    if (group == null || group.getMediaItems() == null) continue;
+                    for (MediaItem item : group.getMediaItems()) {
+                        if (accepted.size() >= ITEMS_PER_LANGUAGE) break;
+                        if (!accepts(item, english, now) || seen.contains(item.getVideoId())) continue;
+                        String publisher = publisher(item).toLowerCase(Locale.ROOT);
+                        int count = publishers.containsKey(publisher) ? publishers.get(publisher) : 0;
+                        if (count >= ITEMS_PER_PUBLISHER) continue;
+                        seen.add(item.getVideoId());
+                        publishers.put(publisher, count + 1);
+                        accepted.add(item);
+                    }
+                }
+            }
+            if (!accepted.isEmpty()) {
+                // Search requests all use the supported Today filter. Unknown timestamps are covered
+                // by that server-side filter; explicit old timestamps are still rejected below.
+                java.util.Collections.sort(accepted, (left, right) -> Long.compare(publishedTime(right, now), publishedTime(left, now)));
+                YouTubeMediaGroup row = new YouTubeMediaGroup(MediaGroup.TYPE_NEWS);
+                row.setTitle(english ? "Breaking news in English" : "Swedish news");
+                row.setMediaItems(accepted);
+                row.setNextPageKey(null);
+                result.add(row);
+            }
+        }
+        return result;
+    }
+
+    private static String publisher(MediaItem item) {
+        String author = item.getAuthor();
+        return author == null ? "unknown" : author.split("[\u2022]", 2)[0].trim();
+    }
+
+    private static long publishedTime(MediaItem item, long now) {
+        if (item.getPublishedDate() > 0) return item.getPublishedDate();
+        String metadata = String.valueOf(item.getProductionDate()) + " " + item.getAuthor();
+        metadata = java.text.Normalizer.normalize(metadata, java.text.Normalizer.Form.NFKD)
+                .replaceAll("\\p{M}+", "").toLowerCase(Locale.ROOT);
+        java.util.regex.Matcher age = java.util.regex.Pattern.compile(
+                "(\\d+)\\s*(minute|minut|hour|timm|day|dag|week|veck|month|manad|year|ar)").matcher(metadata);
+        if (!age.find()) return -1; // The request itself is still restricted to Today.
+        long count = Long.parseLong(age.group(1));
+        String unit = age.group(2);
+        if (unit.equals("week") || unit.equals("veck") || unit.equals("month") || unit.equals("manad") ||
+                unit.equals("year") || unit.equals("ar")) return now - MAX_AGE_MS - 1;
+        long duration = unit.equals("day") || unit.equals("dag") ? 24*60*60*1000L :
+                unit.equals("hour") || unit.equals("timm") ? 60*60*1000L : 60*1000L;
+        return now - count * duration;
+    }
+
+    private static boolean accepts(MediaItem item, boolean english, long now) {
+        if (item == null || !PreferredNewsPolicy.isPublisher(publisher(item), english) || item.getVideoId() == null || item.getVideoId().isEmpty() || item.isUpcoming()) return false;
+        long published = publishedTime(item, now);
+        if (published > 0 && (published < now - MAX_AGE_MS || published > now + 60 * 60 * 1000)) return false;
+        return PreferredNewsPolicy.accepts(item.getTitle(), publisher(item), english ? "Breaking news" : "Swedish news", english);
+    }
+}
